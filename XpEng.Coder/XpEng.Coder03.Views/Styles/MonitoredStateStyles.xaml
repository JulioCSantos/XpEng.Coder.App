<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:XpEng.Coder03.Views.Converters">

    <converters:BooleanToStringConverter x:Key="BoolToStringConverter"/>

    <SolidColorBrush x:Key="MonitoredForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="UnmonitoredForegroundBrush" Color="#9CA3AF"/>

    <Style x:Key="MonitoredAwareTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UnmonitoredForegroundBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MonitoredForegroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonitoredAwareTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource UnmonitoredForegroundBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MonitoredForegroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonitoredAwareCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource UnmonitoredForegroundBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MonitoredForegroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>