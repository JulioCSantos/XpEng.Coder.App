<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:XpEng.Coder03.Views.Converters"
    xmlns:local="clr-namespace:XpEng.Coder03.Views.Controls">

    <converters:BooleanToStringConverter
        x:Key="BoolToStringConverter"/>


    <!-- =========================================================
         Monitored-state brushes
         ========================================================= -->

    <SolidColorBrush
        x:Key="MonitoredForegroundBrush"
        Color="#000000"/>

    <SolidColorBrush
        x:Key="UnmonitoredForegroundBrush"
        Color="#9CA3AF"/>


    <!-- =========================================================
         Monitored-aware TextBlock
         ========================================================= -->

    <Style
        x:Key="MonitoredAwareTextBlockStyle"
        TargetType="TextBlock">

        <Setter
            Property="Foreground"
            Value="{StaticResource UnmonitoredForegroundBrush}"/>

        <Style.Triggers>

            <DataTrigger
                Binding="{Binding IsMonitored}"
                Value="True">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource MonitoredForegroundBrush}"/>

            </DataTrigger>

        </Style.Triggers>

    </Style>


    <!-- =========================================================
         Monitored-aware TextBox
         ========================================================= -->

    <Style
        x:Key="MonitoredAwareTextBoxStyle"
        TargetType="TextBox">

        <Setter
            Property="Foreground"
            Value="{StaticResource UnmonitoredForegroundBrush}"/>

        <Style.Triggers>

            <DataTrigger
                Binding="{Binding IsMonitored}"
                Value="True">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource MonitoredForegroundBrush}"/>

            </DataTrigger>

        </Style.Triggers>

    </Style>


    <!-- =========================================================
         Monitored-aware CheckBox
         ========================================================= -->

    <Style
        x:Key="MonitoredAwareCheckBoxStyle"
        TargetType="CheckBox">

        <Setter
            Property="Foreground"
            Value="{StaticResource UnmonitoredForegroundBrush}"/>

        <Style.Triggers>

            <DataTrigger
                Binding="{Binding IsMonitored}"
                Value="True">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource MonitoredForegroundBrush}"/>

            </DataTrigger>

        </Style.Triggers>

    </Style>


    <!-- =========================================================
         Thin scrollbars
         ========================================================= -->

    <Style
        x:Key="ThinScrollBarStyle"
        TargetType="ScrollBar"
        BasedOn="{StaticResource {x:Type ScrollBar}}">

        <Style.Triggers>

            <Trigger
                Property="Orientation"
                Value="Horizontal">

                <Setter
                    Property="Height"
                    Value="9"/>

            </Trigger>

            <Trigger
                Property="Orientation"
                Value="Vertical">

                <Setter
                    Property="Width"
                    Value="9"/>

            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- =========================================================
         Browse button
         ========================================================= -->

    <Style
        x:Key="BrowseButtonStyle"
        TargetType="Button">

        <Setter
            Property="Content"
            Value="..."/>

        <Setter
            Property="Width"
            Value="28"/>

        <Setter
            Property="Padding"
            Value="6,0"/>

        <Setter
            Property="Margin"
            Value="4,0,0,0"/>

        <Setter
            Property="FontSize"
            Value="11"/>

    </Style>


    <!-- =========================================================
         SmartPathTextBox

         IMPORTANT:
         This derives from MonitoredAwareTextBoxStyle so it keeps
         the monitored/unmonitored foreground behavior.

         When unfocused:
             DisplayPath is shown.

         When focused:
             the real editable Text is shown.
         ========================================================= -->

    <Style
        TargetType="{x:Type local:SmartPathTextBox}"
        BasedOn="{StaticResource MonitoredAwareTextBoxStyle}">

        <Setter
            Property="Background"
            Value="White"/>

        <Setter
            Property="BorderBrush"
            Value="#D1D5DB"/>

        <Setter
            Property="BorderThickness"
            Value="1"/>

        <Setter
            Property="Padding"
            Value="4,2"/>

        <Setter
            Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter
            Property="HorizontalContentAlignment"
            Value="Left"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type local:SmartPathTextBox}">

                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">

                        <Grid>

                            <!--
                                Real editable TextBox content.

                                Hidden while the control is not being edited.
                            -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                Opacity="0"/>


                            <!--
                                Shortened display-only version.
                            -->
                            <TextBlock
                                x:Name="DisplayBlock"
                                Text="{TemplateBinding DisplayPath}"
                                Margin="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalAlignment="Stretch"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                IsHitTestVisible="False"/>

                        </Grid>

                    </Border>


                    <ControlTemplate.Triggers>


                        <!-- =============================================
                             User is editing:
                             show actual full Text.
                             ============================================= -->

                        <Trigger
                            Property="IsKeyboardFocusWithin"
                            Value="True">

                            <Setter
                                TargetName="PART_ContentHost"
                                Property="Opacity"
                                Value="1"/>

                            <Setter
                                TargetName="DisplayBlock"
                                Property="Opacity"
                                Value="0"/>

                            <Setter
                                TargetName="border"
                                Property="Background"
                                Value="White"/>

                            <Setter
                                TargetName="border"
                                Property="BorderBrush"
                                Value="#007ACC"/>

                        </Trigger>


                        <!-- =============================================
                             Hover cue
                             ============================================= -->

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="border"
                                Property="Background"
                                Value="#F8FAFC"/>

                        </Trigger>


                        <!-- =============================================
                             Disabled
                             ============================================= -->

                        <Trigger
                            Property="IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="border"
                                Property="Background"
                                Value="#F5F5F5"/>

                            <Setter
                                TargetName="border"
                                Property="BorderBrush"
                                Value="#E0E0E0"/>

                            <Setter
                                Property="Foreground"
                                Value="#A0A0A0"/>

                        </Trigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


</ResourceDictionary>