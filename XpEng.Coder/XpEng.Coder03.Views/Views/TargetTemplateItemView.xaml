<UserControl x:Class="XpEng.Coder03.Views.Views.TargetTemplateItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:XpEng.Coder03.Views.Controls"
             xmlns:views="clr-namespace:XpEng.Coder03.Views.Views"
             xmlns:viewModels="clr-namespace:XpEng.Coder06.ViewModels;assembly=XpEng.Coder06.ViewModels"
             HorizontalContentAlignment="Stretch">

    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
            Margin="0,0,8,8" Padding="8" HorizontalAlignment="Stretch">

        <StackPanel HorizontalAlignment="Stretch">

            <!-- Card header -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="Monitored" IsChecked="{Binding IsMonitored}"
                          IsEnabled="{Binding CanBeMonitored}" VerticalAlignment="Center" FontWeight="SemiBold">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource MonitoredAwareCheckBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanBeMonitored}" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding MonitoringDisabledReason}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <Button Grid.Column="1" Content=" &#10060; "
                        Command="{Binding DashboardViewModel.DeleteTargetTemplateCommand,
                            Source={x:Static viewModels:MainViewModel.Instance}}"
                        CommandParameter="{Binding}" Foreground="DarkRed" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Delete Target/Template" VerticalAlignment="Center"/>
            </Grid>

            <!-- Keep label beside editor while a useful editor width still fits. -->
            <controls:AdaptivePanel Margin="0,0,0,6">
                <TextBlock Text="Target Directory:" Width="110" FontWeight="Bold" VerticalAlignment="Center"/>

                <Grid MinWidth="320" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:SmartPathTextBox x:Name="TargetTextBox" Grid.Column="0"
                                               FullPath="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="4,2"/>

                    <Button Grid.Column="1" Click="BrowseTargetDirectory_Click"
                            ToolTip="Select Target Output Directory" Style="{StaticResource BrowseButtonStyle}"/>
                </Grid>
            </controls:AdaptivePanel>

            <controls:AdaptivePanel Margin="0,0,0,2">
                <TextBlock Text="Template:" Width="110" FontWeight="Bold" VerticalAlignment="Center"/>

                <Grid MinWidth="320" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:SmartPathTextBox x:Name="TemplateTextBox" Grid.Column="0"
                                               FullPath="{Binding TemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="4,2"/>

                    <Button Grid.Column="1" Click="BrowseTemplate_Click"
                            ToolTip="Select T4 Template File" Style="{StaticResource BrowseButtonStyle}"/>
                </Grid>
            </controls:AdaptivePanel>

        </StackPanel>
    </Border>
</UserControl>