<UserControl x:Class="XpEng.Coder03.Views.Views.PlanItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XpEng.Coder03.Views.Views"
             xmlns:controls="clr-namespace:XpEng.Coder03.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,15,15" Padding="10">
        <StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding PlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                             ToolTip="Plan Name" VerticalAlignment="Center" Margin="0,0,15,0" Padding="4,2"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <CheckBox Content="Monitored" IsChecked="{Binding IsMonitored}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text=" &#9888;" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   ToolTip="This plan has valid Target/Template cards that are currently not monitored."
                                                   Visibility="{Binding HasValidUnmonitoredCards, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Visible|Collapsed'}"/>
                    <TextBlock Text=" &#10071;" FontSize="14" Foreground="#DC2626" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   ToolTip="This plan has populated cards with invalid paths that cannot be monitored."
                                                   Visibility="{Binding HasInvalidPopulatedCards, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Visible|Collapsed'}"/>
                </StackPanel>

                <Button Grid.Column="4" Content=" &#10060; " 
                                            Command="{Binding DataContext.DeletePlanCommand,  RelativeSource={RelativeSource AncestorType={x:Type local:DashboardView}}}" 
                                            CommandParameter="{Binding}" 
                                            Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                            ToolTip="Delete Plan" VerticalAlignment="Center"/>
            </Grid>

            <!-- SETUP LEVEL — Plan-scoped, one-shot, distinct from continuous file-watching. -->
            <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Margin="30,0,0,15" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Setup" FontWeight="SemiBold" Foreground="#4338CA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Grid.Column="2" Content="Active" IsChecked="{Binding IsSetupActive, Mode=TwoWay}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                      ToolTip="Runs on the next Force Sync. Automatically unchecks itself once Setup completes successfully."/>
                    </Grid>

                    <!--Adaptive layout for Solution File-->
                    <controls:AdaptivePanel Margin="0,0,0,8">
                        <TextBlock Text="Solution File:" Width="95" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- TextBox with flexible sizing, constraints, and two-way binding preserved -->
                            <TextBox Grid.Column="0" Text="{Binding SetupSolutionFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         ToolTip="Solution File (.sln / .slnx)" VerticalAlignment="Center" Padding="4,2"
                                                         MinWidth="220" MaxWidth="900"/>
                            <Button Grid.Column="1" Click="BrowseSetupSolutionFile_Click" ToolTip="Select Solution File" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>
                    </controls:AdaptivePanel>

                    <!--Adaptive layout for Setup Template-->
                    <controls:AdaptivePanel Margin="0,0,0,8">
                        <TextBlock Text="Setup Template:" Width="95" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Only the TextBox keeps a MinWidth constraint -->
                            <TextBox Grid.Column="0" Text="{Binding SetupTemplatePathDisplay, Mode=OneWay}" IsReadOnly="True"
                                                         ToolTip="{Binding SetupTemplatePath}" VerticalAlignment="Center" Padding="4,2"
                                                         MinWidth="220" MaxWidth="900"/>
                            <Button Grid.Column="1" Click="BrowseSetupTemplate_Click" ToolTip="Select Setup Template File" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>
                    </controls:AdaptivePanel>

                </StackPanel>
            </Border>

            <!-- SOURCE DIRECTORY LEVEL -->
            <Grid Margin="30,0,0,0">
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Source Directories" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding SourceDirectories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SourceDirectoryItemView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#B3FFFFFF" IsHitTestVisible="False"
                                            Visibility="{Binding IsMonitored, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
