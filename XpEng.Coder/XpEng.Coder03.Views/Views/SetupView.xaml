<UserControl x:Class="XpEng.Coder03.Views.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:XpEng.Coder03.Views.Controls">

    <UserControl.Resources>
        <!--
            Reused in both collapsed and expanded layouts.
            Both instances bind to the same PlanOrchestratorPoco.
        -->
        <DataTemplate x:Key="SolutionFileRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Empty when used alone; shares the checkbox width in expanded layout. -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SetupActivation"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SetupLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SetupBrowse"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Solution File:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <controls:SmartPathTextBox Grid.Column="1"
                            FullPath="{Binding SetupSolutionFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                            ToolTip="{Binding SetupSolutionFile}" VerticalAlignment="Center"
                            Padding="4,2" MinWidth="220" MaxWidth="900"/>

                    <Button Grid.Column="2" Click="BrowseSetupSolutionFile_Click"
                            ToolTip="Select Solution File" Style="{StaticResource BrowseButtonStyle}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="10">
        <Expander x:Name="SetupExpander" IsExpanded="True">

            <!-- Header always remains one row high. -->
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Setup" FontSize="15" FontWeight="Bold" Foreground="#3730A3"
                               VerticalAlignment="Center"/>

                    <!-- Collapsed representation of Solution File. -->
                    <ContentControl Grid.Column="1" Content="{Binding}"
                                    ContentTemplate="{StaticResource SolutionFileRowTemplate}"
                                    Margin="20,0,0,0" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=SetupExpander}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Expander.Header>

            <!-- Expanded representation. Alignment is completely owned by SetupView. -->
            <StackPanel Grid.IsSharedSizeScope="True" Margin="30,8,0,0">

                <!-- Solution File remains independently useful regardless of IsSetupActive. -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SolutionFileRowTemplate}"
                                Margin="0,0,0,8"/>

                <!-- Setup Template is subordinate and independently activatable. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SetupActivation"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSetupActive, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Run the Setup Template on the next Force Sync. Automatically clears after successful completion."/>

                    <!-- Dim only the dependent controls; the checkbox stays full strength. -->
                    <Grid Grid.Column="1" controls:Dimmer.IsActive="{Binding IsSetupActive}"
                          Style="{StaticResource DimWhenInactiveStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SetupLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SetupBrowse"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Setup Template:" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <controls:SmartPathTextBox Grid.Column="1"
                                FullPath="{Binding SetupTemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                ToolTip="{Binding SetupTemplatePath}" VerticalAlignment="Center"
                                Padding="4,2" MinWidth="220" MaxWidth="900"/>

                        <Button Grid.Column="2" Click="BrowseSetupTemplate_Click"
                                ToolTip="Select Setup Template File" Style="{StaticResource BrowseButtonStyle}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Expander>
    </Border>
</UserControl>