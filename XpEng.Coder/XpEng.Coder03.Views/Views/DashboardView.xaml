<UserControl x:Class="XpEng.Coder03.Views.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:XpEng.Coder06.ViewModels;assembly=XpEng.Coder06.ViewModels"
             xmlns:converters="clr-namespace:XpEng.Coder03.Views.Converters"
             mc:Ignorable="d"
             DataContext="{Binding DashboardViewModel, Source={x:Static viewModels:MainViewModel.Instance}}"             
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BooleanToStringConverter x:Key="BoolToStringConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- ACTION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Engine Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="AutoSave" IsChecked="{Binding AutoSave}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                <Button Content="Save Now" Command="{Binding SaveConfigurationCommand}" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleWatchCommand}" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button Content="Force Sync" Command="{Binding ForceSyncCommand}" Padding="15,5"/>
            </StackPanel>
        </Grid>

        <!-- NESTED GRIDS (MASTER-DETAIL IMPLEMENTATION) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding UIPlans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,15,15" Padding="10">
                            <StackPanel>

                                <!-- MASTER ROW: PlanOrchestrator -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Label -->
                                        <ColumnDefinition Width="2*"/>
                                        <!-- Plan Name -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Label -->
                                        <ColumnDefinition Width="4*"/>
                                        <!-- Source Dir -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Browse Btn -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Delete Btn -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding PlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                             ToolTip="Plan Name" VerticalAlignment="Center" Margin="0,0,15,0" Padding="4,2"/>

                                    <TextBlock Grid.Column="2" Text="Source Directory:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>

                                    <!-- Shortened-path overlay: TextBlock shows the shortened path and hides on focus,
                                         revealing the full-path TextBox underneath for editing -->
                                    <Grid Grid.Column="3">
                                        <TextBox x:Name="SourceDirectoryEditBox"
                                                 Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                 ToolTip="Source Directory" VerticalAlignment="Center" Padding="4,2"
                                                 GotFocus="SourceDirectoryEditBox_GotFocus" LostFocus="SourceDirectoryEditBox_LostFocus"/>
                                        <TextBlock Text="{Binding SourceDirectoryDisplay}"
                                                   ToolTip="{Binding SourceDirectory}"
                                                   Background="White"
                                                   Padding="6,4"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="True"
                                                   MouseLeftButtonDown="DisplayOverlay_MouseLeftButtonDown"
                                                   Tag="{Binding ElementName=SourceDirectoryEditBox}"
                                                   Visibility="{Binding IsEditingSourceDirectory, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
                                    </Grid>

                                    <Button Grid.Column="4" Content="..." Click="BrowseSource_Click" Padding="10,2" Margin="5,0,15,0" VerticalAlignment="Center"/>

                                    <Button Grid.Column="5" Content=" ❌ " 
                                            Command="{Binding DataContext.DeletePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                            ToolTip="Delete Plan" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- DETAIL ROWS: TemplateTargets -->
                                <!-- Indented with a white background to signify the 1-to-many relationship -->
                                <Border Margin="40,0,0,0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                    <StackPanel>

                                        <!-- Detail Grid Headers -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <!-- Checkbox -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Target Dir -->
                                                <ColumnDefinition Width="35"/>
                                                <!-- Browse Btn -->
                                                <ColumnDefinition Width="15"/>
                                                <!-- Spacer -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Template Path -->
                                                <ColumnDefinition Width="35"/>
                                                <!-- Browse Btn -->
                                                <ColumnDefinition Width="35"/>
                                                <!-- Delete Btn -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Target Directory" FontWeight="SemiBold" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="4" Text="Template Path" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        </Grid>

                                        <!-- Detail Grid Rows -->
                                        <ItemsControl ItemsSource="{Binding TemplateTargets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="15"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsMonitored}" ToolTip="Monitor" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                        <!-- Target Directory: shortened-path overlay -->
                                                        <Grid Grid.Column="1">
                                                            <TextBox x:Name="TargetDirectoryEditBox"
                                                                     Text="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                     VerticalAlignment="Center" Padding="4,2"
                                                                     GotFocus="TargetDirectoryEditBox_GotFocus" LostFocus="TargetDirectoryEditBox_LostFocus"/>
                                                            <TextBlock Text="{Binding TargetDirectoryDisplay}"
                                                                       ToolTip="{Binding TargetDirectory}"
                                                                       Background="White"
                                                                       Padding="6,4"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="True"
                                                                       MouseLeftButtonDown="DisplayOverlay_MouseLeftButtonDown"
                                                                       Tag="{Binding ElementName=TargetDirectoryEditBox}"
                                                                       Visibility="{Binding IsEditingTargetDirectory, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
                                                        </Grid>
                                                        <Button Grid.Column="2" Content="..." Click="BrowseTarget_Click" Padding="8,2" Margin="5,0,0,0" VerticalAlignment="Center"/>

                                                        <!-- Template Path: shortened-path overlay -->
                                                        <Grid Grid.Column="4">
                                                            <TextBox x:Name="TemplatePathEditBox"
                                                                     Text="{Binding TemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                     VerticalAlignment="Center" Padding="4,2"
                                                                     GotFocus="TemplatePathEditBox_GotFocus" LostFocus="TemplatePathEditBox_LostFocus"/>
                                                            <TextBlock Text="{Binding TemplatePathDisplay}"
                                                                       ToolTip="{Binding TemplatePath}"
                                                                       Background="White"
                                                                       Padding="6,4"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="True"
                                                                       MouseLeftButtonDown="DisplayOverlay_MouseLeftButtonDown"
                                                                       Tag="{Binding ElementName=TemplatePathEditBox}"
                                                                       Visibility="{Binding IsEditingTemplatePath, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
                                                        </Grid>
                                                        <Button Grid.Column="5" Content="..." Click="BrowseTemplate_Click" Padding="8,2" Margin="5,0,0,0" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="6" Content=" ❌ " 
                                                                Command="{Binding DataContext.DeleteTemplateTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0" Margin="10,0,0,0"
                                                                ToolTip="Delete Target Row" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- SPLITTER & LOGS -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D1D5DB" Margin="0,5,15,5" Cursor="SizeNS"/>

        <Grid Grid.Row="3" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="System Logs" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,5"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyLogsCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
