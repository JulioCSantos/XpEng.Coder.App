<UserControl x:Class="XpEng.Coder03.Views.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:XpEng.Coder06.ViewModels;assembly=XpEng.Coder06.ViewModels"
             xmlns:converters="clr-namespace:XpEng.Coder03.Views.Converters"
             mc:Ignorable="d"
             DataContext="{Binding DashboardViewModel, Source={x:Static viewModels:MainViewModel.Instance}}"             
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BooleanToStringConverter x:Key="BoolToStringConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- ACTION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Engine Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="AutoSave" IsChecked="{Binding AutoSave}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                <Button Content="Save Now" Command="{Binding SaveConfigurationCommand}" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleWatchCommand}" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button Content="Force Sync" Command="{Binding ForceSyncCommand}" Padding="15,5"/>
            </StackPanel>
        </Grid>

        <!-- PLAN TREE: Plan -> Source Directories -> Target/Template rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding UIPlans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- PLAN LEVEL -->
                        <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,15,15" Padding="10">
                            <StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding PlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                             ToolTip="Plan Name" VerticalAlignment="Center" Margin="0,0,15,0" Padding="4,2"/>

                                    <CheckBox Grid.Column="3" Content="Monitored" IsChecked="{Binding IsMonitored}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>

                                    <Button Grid.Column="4" Content=" &#10060; " 
                                            Command="{Binding DataContext.DeletePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                            ToolTip="Delete Plan" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- SOURCE DIRECTORY LEVEL -->
                                <Border Margin="30,0,0,0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Source Directories" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6"/>

                                        <ItemsControl ItemsSource="{Binding SourceDirectories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                        <StackPanel>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="Source:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <!-- SourceDirectory is exempt from shortening: full path, plain TextBox, no overlay -->
                                                                <TextBox Grid.Column="1" Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                         ToolTip="Source Directory (monitored)" VerticalAlignment="Center" Padding="4,2"/>
                                                                <Button Grid.Column="2" Content="..." Click="BrowseSource_Click" Padding="10,2" Margin="5,0,10,0" VerticalAlignment="Center"/>

                                                                <Button Grid.Column="3" Content=" &#10060; " 
                                                                        Command="{Binding DataContext.DeleteSourceDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}" 
                                                                        Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                                                        ToolTip="Delete Source Directory" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- TARGET/TEMPLATE LEVEL: flat rows, 2 columns -->
                                                            <Border Margin="30,0,0,0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Target Directories &amp; Templates" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6"/>

                                                                    <ItemsControl ItemsSource="{Binding TargetTemplates}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <UniformGrid Columns="2"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,8,8" Padding="8">
                                                                                    <StackPanel>

                                                                                        <Grid Margin="0,0,0,6">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsMonitored}" ToolTip="Monitor" VerticalAlignment="Center"/>
                                                                                            <TextBlock Grid.Column="1"/>
                                                                                            <Button Grid.Column="2" Content=" &#10060; " 
                                                                                                    Command="{Binding DataContext.DeleteTargetTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                                    CommandParameter="{Binding}" 
                                                                                                    Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                                                                                    ToolTip="Delete Target/Template" VerticalAlignment="Center"/>
                                                                                        </Grid>

                                                                                        <!-- Target Directory: shortened-path overlay -->
                                                                                        <TextBlock Text="Target Directory" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                                                        <Grid Margin="0,0,0,6">
                                                                                            <TextBox x:Name="TargetDirectoryEditBox"
                                                                                                     Text="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                                                     Padding="4,2"
                                                                                                     GotFocus="TargetDirectoryEditBox_GotFocus" LostFocus="TargetDirectoryEditBox_LostFocus"/>
                                                                                            <Grid>
                                                                                                <TextBlock Text="{Binding TargetDirectoryDisplay}"
                                                                                                           ToolTip="{Binding TargetDirectory}"
                                                                                                           Background="White"
                                                                                                           Padding="6,4"
                                                                                                           IsHitTestVisible="True"
                                                                                                           MouseLeftButtonDown="DisplayOverlay_MouseLeftButtonDown"
                                                                                                           Tag="{Binding ElementName=TargetDirectoryEditBox}"
                                                                                                           Visibility="{Binding IsEditingTargetDirectory, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
                                                                                            </Grid>
                                                                                        </Grid>
                                                                                        <Button Content="Browse target..." Click="BrowseTarget_Click" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8" FontSize="11"/>

                                                                                        <!-- Template Path: shortened-path overlay -->
                                                                                        <TextBlock Text="Template" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                                                        <Grid Margin="0,0,0,4">
                                                                                            <TextBox x:Name="TemplatePathEditBox"
                                                                                                     Text="{Binding TemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                                                     Padding="4,2"
                                                                                                     GotFocus="TemplatePathEditBox_GotFocus" LostFocus="TemplatePathEditBox_LostFocus"/>
                                                                                            <Grid>
                                                                                                <TextBlock Text="{Binding TemplatePathDisplay}"
                                                                                                           ToolTip="{Binding TemplatePath}"
                                                                                                           Background="White"
                                                                                                           Padding="6,4"
                                                                                                           IsHitTestVisible="True"
                                                                                                           MouseLeftButtonDown="DisplayOverlay_MouseLeftButtonDown"
                                                                                                           Tag="{Binding ElementName=TemplatePathEditBox}"
                                                                                                           Visibility="{Binding IsEditingTemplatePath, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Collapsed|Visible'}"/>
                                                                                            </Grid>
                                                                                        </Grid>
                                                                                        <Button Content="Browse template..." Click="BrowseTemplate_Click" HorizontalAlignment="Left" Padding="8,2" FontSize="11"/>

                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- SPLITTER & LOGS -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D1D5DB" Margin="0,5,15,5" Cursor="SizeNS"/>

        <Grid Grid.Row="3" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="System Logs" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Clear Logs" Command="{Binding ClearLogsCommand}" Padding="10,2" FontSize="11"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyLogsCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
