<UserControl x:Class="XpEng.Coder03.Views.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:XpEng.Coder06.ViewModels;assembly=XpEng.Coder06.ViewModels"
             xmlns:converters="clr-namespace:XpEng.Coder03.Views.Converters"
             xmlns:views="clr-namespace:XpEng.Coder03.Views.Views"
             mc:Ignorable="d"
             DataContext="{Binding DashboardViewModel, Source={x:Static viewModels:MainViewModel.Instance}}"             
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- ACTION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Engine Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="AutoSave" IsChecked="{Binding AutoSave}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                <Button Content="Save Now" Command="{Binding SaveConfigurationCommand}" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleWatchCommand}" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button Content="Force Sync" Command="{Binding ForceSyncCommand}" Padding="15,5"/>
            </StackPanel>
        </Grid>

        <!-- PLAN TREE: Plan -> Source Directories -> Target/Template rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding UIPlans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- PLAN LEVEL -->
                        <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,15,15" Padding="10">
                            <StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding PlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                             ToolTip="Plan Name" VerticalAlignment="Center" Margin="0,0,15,0" Padding="4,2"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <CheckBox Content="Monitored" IsChecked="{Binding IsMonitored}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text=" &#9888;" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   ToolTip="This plan has valid Target/Template cards that are currently not monitored."
                                                   Visibility="{Binding HasValidUnmonitoredCards, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Visible|Collapsed'}"/>
                                        <TextBlock Text=" &#10071;" FontSize="14" Foreground="#DC2626" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   ToolTip="This plan has populated cards with invalid paths that cannot be monitored."
                                                   Visibility="{Binding HasInvalidPopulatedCards, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Visible|Collapsed'}"/>
                                    </StackPanel>

                                    <Button Grid.Column="4" Content=" &#10060; " 
                                            Command="{Binding DataContext.DeletePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                            ToolTip="Delete Plan" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- SOURCE DIRECTORY LEVEL -->
                                <Border Margin="30,0,0,0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Source Directories" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6"/>

                                        <ItemsControl ItemsSource="{Binding SourceDirectories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                        <StackPanel>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="Source:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <!-- SourceDirectory is exempt from shortening: full path, plain TextBox, no overlay -->
                                                                <TextBox Grid.Column="1" Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                                         ToolTip="Source Directory (monitored)" VerticalAlignment="Center" Padding="4,2"/>
                                                                <Button Grid.Column="2" Content="..." Click="BrowseSource_Click" Padding="6,0" MinWidth="24" Margin="4,0,8,0" FontSize="11" ToolTip="Select Source Directory (Monitored)" VerticalAlignment="Center"/>

                                                                <Button Grid.Column="3" Content=" &#10060; " 
                                                                        Command="{Binding DataContext.DeleteSourceDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}" 
                                                                        Foreground="DarkRed" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                                                        ToolTip="Delete Source Directory" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- TARGET/TEMPLATE LEVEL: WrapPanel of TargetTemplateItemView cards -->
                                                            <Border Margin="30,0,0,0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Target Directories &amp; Templates" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6"/>

                                                                    <ListBox ItemsSource="{Binding TargetTemplates}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" Loaded="TargetTemplatesListBox_Loaded" SizeChanged="TargetTemplatesListBox_SizeChanged">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <views:TargetTemplateItemView/>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                        <ListBox.ItemContainerStyle>
                                                                            <Style TargetType="ListBoxItem">
                                                                                <Setter Property="Focusable" Value="False"/>
                                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                    </ListBox>
                                                                </StackPanel>
                                                            </Border>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- SPLITTER & LOGS -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D1D5DB" Margin="0,5,15,5" Cursor="SizeNS"/>

        <Grid Grid.Row="3" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="System Logs" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Clear Logs" Command="{Binding ClearLogsCommand}" Padding="10,2" FontSize="11"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyLogsCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>