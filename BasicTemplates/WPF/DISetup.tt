<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Memory" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ include file="../Shared/TemplateArguments.ttinclude" #>
<#@ include file="../Shared/TemplateLog.ttinclude" #>
<#@ include file="../Shared/SolutionGraph.ttinclude" #>
<#@ include file="../Shared/TargetFolders.ttinclude" #>
<#
    // ============================================================
    // TARGET FOLDERS — where this template writes, relative to each project's root.
    // Created if absent. Edit these to match a different solution's conventions; the
    // generation code below never contains a literal path.
    //
    //   Key      how the template refers to the folder
    //   Path     relative to the project root; "" means the root itself
    //   Patterns wildcard match against the PROJECT NAME. Positives OR together; a
    //            pattern prefixed with '!' excludes and always wins. Omit for all projects.
    //
    // When two entries match the same project for one key, the FIRST wins and the ambiguity
    // is logged as a warning.
    // ============================================================
    var TargetFolders = new[] {
        new TargetFolder("DI", "DI")
    };

    // ============================================================
    // ARGUMENTS (read from {SolutionRoot}\CoderFiles\DISetup.args.txt)
    //
    //   SolutionFilePath  (required) — full path to the .slnx/.sln to set up.
    //
    // Generates, into the DEEPEST project (which every other project already references,
    // transitively — so the mechanism lives in one place rather than being duplicated):
    //
    //   {Infrastructure}/DI/RegisterAttribute.g.cs         declares how a type registers itself
    //   {Infrastructure}/DI/IAddRegistrations.g.cs         contributes registrations for types it does not own
    //   {Infrastructure}/DI/IOverrideRegistrations.g.cs    replaces registrations deliberately
    //   {Infrastructure}/DI/ServiceLocator.g.cs            holds the built provider, with scoping for tests
    //   {Infrastructure}/DI/RegistrationScanner.g.cs       the scan itself
    //
    // And, into EVERY production project (test projects skipped):
    //
    //   {Project}/DI/ServiceCollectionExtensions.g.cs      AddRegistrations, cascading into dependencies
    //
    // Namespaces come from each project's RootNamespace (read from its .csproj, not inferred
    // from the folder name — the two can legitimately differ).
    //
    // Hand-written companions this generates seams for, never overwritten:
    //   {Project}/ServiceCollectionExtensions.Manual.cs    implements AddManualRegistrations
    //   {Project}/DI/*.cs implementing IAddRegistrations or IOverrideRegistrations
    // ============================================================

    if (!HasArguments) {
        LogError($"No arguments file found. Looked at: {ArgumentsFilePathForDiagnostics}", null);
        return string.Empty;
    }

    string solutionFilePath = GetArgument("SolutionFilePath");
    if (string.IsNullOrWhiteSpace(solutionFilePath)) {
        LogError($"SolutionFilePath is missing from {ArgumentsFilePathForDiagnostics}", null);
        return string.Empty;
    }

    if (!File.Exists(solutionFilePath)) {
        LogError($"Solution file does not exist: {solutionFilePath}", null);
        return string.Empty;
    }

    Log($"Arguments file  : {ArgumentsFilePathForDiagnostics}");
    Log($"SolutionFilePath: {solutionFilePath}");

    BuildSolutionGraph(solutionFilePath);
    foreach (string diagnostic in GraphDiagnostics) Log("GRAPH: " + diagnostic);

    var projects = ProductionProjectsByTier();
    if (projects.Count == 0) {
        LogError("No production projects found in the solution.", solutionFilePath);
        return string.Empty;
    }

    // The deepest project. Every other project already references it, transitively, which is
    // what makes it the right home for anything the whole solution needs to reach.
    var infrastructureProject = projects.Last();

    var deepestTierProjects = projects.Where(p => p.Tier == infrastructureProject.Tier).ToList();
    if (deepestTierProjects.Count > 1) {
        LogError(
            "Several projects share the deepest tier (" + infrastructureProject.Tier + "): " +
            string.Join(", ", deepestTierProjects.Select(p => p.ProjectName)) + ". " +
            "The shared DI components must live in a project every other one references; " +
            "narrow the solution so exactly one project sits at the deepest tier.",
            solutionFilePath);
        return string.Empty;
    }

    Log($"Production projects: {projects.Count}, test projects skipped: {FindTestProjects().Count}");
    Log($"Shared DI components -> {infrastructureProject.ProjectName} (tier {infrastructureProject.Tier}, namespace {infrastructureProject.RootNamespace})");
    Log("");

    int filesWritten = 0;
    int stubsSkipped = 0;

    // ---- shared components, once ----
    string infrastructureDiFolder = ResolveTargetFolder(TargetFolders, "DI", infrastructureProject);
    Log($"[{infrastructureProject.ProjectName}] -> {MakeRelativePath(infrastructureProject.ProjectDirectory, infrastructureDiFolder)}");

    WriteDiFile(infrastructureDiFolder, "RegisterAttribute.g.cs", BuildRegisterAttribute(infrastructureProject), ref filesWritten);
    WriteDiFile(infrastructureDiFolder, "IAddRegistrations.g.cs", BuildAddRegistrationsInterface(infrastructureProject), ref filesWritten);
    WriteDiFile(infrastructureDiFolder, "IOverrideRegistrations.g.cs", BuildOverrideRegistrationsInterface(infrastructureProject), ref filesWritten);
    WriteDiFile(infrastructureDiFolder, "ServiceLocator.g.cs", BuildServiceLocator(infrastructureProject), ref filesWritten);
    WriteDiFile(infrastructureDiFolder, "RegistrationScanner.g.cs", BuildRegistrationScanner(infrastructureProject), ref filesWritten);
    Log("");

    // ---- per-project entry point ----
    foreach (var project in projects) {
        var directDependencies = project.Dependencies.Where(d => !d.IsTestProject).OrderBy(d => d.ProjectName).ToList();

        Log($"[Tier {project.Tier}] {project.ProjectName}  (namespace {project.RootNamespace})");
        if (directDependencies.Count > 0)
            Log($"    cascades into: {string.Join(", ", directDependencies.Select(d => d.ProjectName))}");

        string projectDiFolder = ResolveTargetFolder(TargetFolders, "DI", project);
        WriteDiFile(projectDiFolder, "ServiceCollectionExtensions.g.cs",
            BuildServiceCollectionExtensions(project, directDependencies, infrastructureProject), ref filesWritten);

        // A hand-written stub, created ONCE and never regenerated — it is where a developer
        // puts registrations the attribute scan cannot express, so overwriting it would
        // destroy real work. No .g.cs suffix, for the same reason.
        WriteManualStubIfMissing(project, infrastructureProject, ref filesWritten, ref stubsSkipped);
    }

    // Documentation of the mechanism, copied beside the arguments file. Overwritten every
    // run: unlike the Manual.cs stubs nobody edits this, and a stale copy describing a
    // mechanism that has since changed is worse than none.
    string readmePath = Path.Combine(Path.GetDirectoryName(solutionFilePath), "CoderFiles", "README-DependencyInjection.md");
    Directory.CreateDirectory(Path.GetDirectoryName(readmePath));
    File.WriteAllText(readmePath, BuildReadme(infrastructureProject, projects));
    Log("");
    Log("Wrote " + MakeRelativePath(SolutionDirectory, readmePath));

    Log("");
    Log($"Done. {filesWritten} file(s) written" + (stubsSkipped > 0 ? $", {stubsSkipped} existing stub(s) left untouched." : "."));
    Log("");
    Log("Composition root:");
    Log("    var services = new ServiceCollection();");
    Log("    " + projects.First(p => p.Tier == 1).RootNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
    Log("    " + infrastructureProject.RootNamespace + ".ServiceLocator.Initialize(services.BuildServiceProvider());");

    FlushLog(solutionFilePath);

    Write($"DI setup complete: {filesWritten} file(s) across {projects.Count} project(s).");
#>
<#+
    // Required by TemplateArguments.ttinclude and TemplateLog.ttinclude: under the t4 CLI,
    // Host.TemplateFile is empty, so the template cannot discover its own name.
    private string TemplateNameFallback { get { return "DISetup"; } }

    private void WriteDiFile(string folder, string fileName, string content, ref int counter) {
        File.WriteAllText(Path.Combine(folder, fileName), content);
        Log("    wrote " + fileName);
        counter++;
    }

    private string GeneratedBanner(string sourceDescription) {
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     Generated by the DISetup template. Do not edit — regenerated on every run.");
        sb.AppendLine("//     " + sourceDescription);
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("#nullable enable");
        sb.AppendLine();
        return sb.ToString();
    }

    private string BuildRegisterAttribute(SolutionProject project) {
        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("Declares how a type registers itself with the DI container."));
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("/// <summary>");
        sb.AppendLine("/// Marks a class for automatic DI registration. Applied to the implementation; the");
        sb.AppendLine("/// service type defaults to the class itself when not given.");
        sb.AppendLine("///");
        sb.AppendLine("/// The class needs a PUBLIC constructor — the scan activates it by reflection. A type");
        sb.AppendLine("/// with an internal or protected constructor registers through a factory in a");
        sb.AppendLine("/// hand-written ServiceCollectionExtensions.Manual.cs instead.");
        sb.AppendLine("///");
        sb.AppendLine("/// AllowMultiple, so one class can be resolvable under several interfaces.");
        sb.AppendLine("/// </summary>");
        sb.AppendLine("[AttributeUsage(AttributeTargets.Class, AllowMultiple = true)]");
        sb.AppendLine("public sealed class RegisterAttribute : Attribute {");
        sb.AppendLine();
        sb.AppendLine("    public Type? ServiceType { get; }");
        sb.AppendLine("    public ServiceLifetime Lifetime { get; }");
        sb.AppendLine();
        sb.AppendLine("    public RegisterAttribute(ServiceLifetime lifetime = ServiceLifetime.Singleton) {");
        sb.AppendLine("        Lifetime = lifetime;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    public RegisterAttribute(Type serviceType, ServiceLifetime lifetime = ServiceLifetime.Singleton) {");
        sb.AppendLine("        ServiceType = serviceType;");
        sb.AppendLine("        Lifetime = lifetime;");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildAddRegistrationsInterface(SolutionProject project) {
        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("Contributes registrations for types this class does not own."));
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("/// <summary>");
        sb.AppendLine("/// Registers types this class does not own — a scaffolded entity, a hand-written class,");
        sb.AppendLine("/// anything a [Register] attribute cannot reach because the type cannot be decorated.");
        sb.AppendLine("///");
        sb.AppendLine("/// Any number of implementations may coexist, so several templates can contribute to");
        sb.AppendLine("/// the same project independently. Registrations made here are VALIDATED: two sources");
        sb.AppendLine("/// registering the same service type without declaring intent to override is an error.");
        sb.AppendLine("/// To replace an existing registration deliberately, use IOverrideRegistrations.");
        sb.AppendLine("///");
        sb.AppendLine("/// Implementations need a public parameterless constructor.");
        sb.AppendLine("/// </summary>");
        sb.AppendLine("public interface IAddRegistrations {");
        sb.AppendLine("    void AddRegistrations(IServiceCollection services);");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildOverrideRegistrationsInterface(SolutionProject project) {
        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("Replaces registrations deliberately."));
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("/// <summary>");
        sb.AppendLine("/// Replaces registrations made earlier. Runs after the attribute scan and after every");
        sb.AppendLine("/// IAddRegistrations contributor, and is NOT subject to duplicate validation — replacing");
        sb.AppendLine("/// is the declared intent, expressed as one statement rather than a remove followed by");
        sb.AppendLine("/// an add.");
        sb.AppendLine("///");
        sb.AppendLine("/// This is the mechanism for resolving a conflict between two independently generated");
        sb.AppendLine("/// registrations, and the natural home for test substitutions.");
        sb.AppendLine("///");
        sb.AppendLine("/// Use plain Add* calls; the scanner removes whatever the same service type was");
        sb.AppendLine("/// registered as before.");
        sb.AppendLine("/// </summary>");
        sb.AppendLine("public interface IOverrideRegistrations {");
        sb.AppendLine("    void ReplaceRegistrations(IServiceCollection services);");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildServiceLocator(SolutionProject project) {
        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("Holds the built container for code constructor injection cannot reach."));
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("/// <summary>");
        sb.AppendLine("/// Holds the application's built container so code that cannot receive a dependency");
        sb.AppendLine("/// through its constructor can still resolve one — a static Instance property, a");
        sb.AppendLine("/// XAML-constructed view, a design-time fallback.");
        sb.AppendLine("///");
        sb.AppendLine("/// Named for the pattern it is rather than something softer: this is a service locator,");
        sb.AppendLine("/// used deliberately where constructor injection cannot reach.");
        sb.AppendLine("///");
        sb.AppendLine("/// Two levels: a DEFAULT provider set once at startup, and a SCOPED provider set");
        sb.AppendLine("/// through UseProvider that overrides it for the current asynchronous context.");
        sb.AppendLine("///");
        sb.AppendLine("/// AsyncLocal rather than ThreadStatic: a ThreadStatic value does not survive an await —");
        sb.AppendLine("/// the continuation can resume on a different pool thread — so an async test would");
        sb.AppendLine("/// silently fall back to the default.");
        sb.AppendLine("/// </summary>");
        sb.AppendLine("public static class ServiceLocator {");
        sb.AppendLine();
        sb.AppendLine("    private static readonly AsyncLocal<IServiceProvider?> _scopedProvider = new();");
        sb.AppendLine("    private static IServiceProvider? _defaultProvider;");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// The provider in effect: the scoped one when the current context has set one,");
        sb.AppendLine("    /// otherwise the application default. Throws rather than returning null when neither");
        sb.AppendLine("    /// exists, so the failure names its own cause.");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public static IServiceProvider CurrentProvider {");
        sb.AppendLine("        get {");
        sb.AppendLine("            var provider = _scopedProvider.Value ?? _defaultProvider;");
        sb.AppendLine();
        sb.AppendLine("            if (provider == null)");
        sb.AppendLine("                throw new InvalidOperationException(");
        sb.AppendLine("                    \"The service provider has not been built. Call ServiceLocator.Initialize(provider) \" +");
        sb.AppendLine("                    \"during startup, after AddRegistrations and BuildServiceProvider — or, in a test, \" +");
        sb.AppendLine("                    \"wrap the code under test in ServiceLocator.UseProvider(...).\");");
        sb.AppendLine();
        sb.AppendLine("            return provider;");
        sb.AppendLine("        }");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>True when a provider is available. Lets a caller fall back rather than");
        sb.AppendLine("    /// throw — the design-time case, where startup never runs at all.</summary>");
        sb.AppendLine("    public static bool IsInitialized => (_scopedProvider.Value ?? _defaultProvider) != null;");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>Sets the application-wide provider. Called once, from the composition root.</summary>");
        sb.AppendLine("    public static void Initialize(IServiceProvider provider) {");
        sb.AppendLine("        _defaultProvider = provider;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// Overrides the provider for the current asynchronous context until the returned");
        sb.AppendLine("    /// scope is disposed, which restores whatever was in effect before — so nested and");
        sb.AppendLine("    /// sequential uses both behave.");
        sb.AppendLine("    ///");
        sb.AppendLine("    /// Named as an action rather than an accessor because the result MUST be disposed;");
        sb.AppendLine("    /// a scope left open stays in effect for the rest of the context.");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public static IDisposable UseProvider(IServiceProvider provider) {");
        sb.AppendLine("        if (provider == null) throw new ArgumentNullException(nameof(provider));");
        sb.AppendLine("        return new ProviderScope(provider);");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>Clears the application-wide provider. For a test process that builds");
        sb.AppendLine("    /// several containers and needs one not to leak into the next.</summary>");
        sb.AppendLine("    public static void Reset() {");
        sb.AppendLine("        _defaultProvider = null;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    private sealed class ProviderScope : IDisposable {");
        sb.AppendLine();
        sb.AppendLine("        private readonly IServiceProvider? _previous;");
        sb.AppendLine("        private bool _disposed;");
        sb.AppendLine();
        sb.AppendLine("        internal ProviderScope(IServiceProvider provider) {");
        sb.AppendLine("            _previous = _scopedProvider.Value;");
        sb.AppendLine("            _scopedProvider.Value = provider;");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        public void Dispose() {");
        sb.AppendLine("            if (_disposed) return;");
        sb.AppendLine("            _disposed = true;");
        sb.AppendLine("            _scopedProvider.Value = _previous;");
        sb.AppendLine("        }");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildRegistrationScanner(SolutionProject project) {
        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("Applies every registration an assembly declares."));
        sb.AppendLine("using System.Reflection;");
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("public static class RegistrationScanner {");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// Scans one assembly and applies every registration it declares, in four steps:");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///   1. [Register] attributes — a type declaring how it registers itself.");
        sb.AppendLine("    ///   2. IAddRegistrations contributors — classes registering types they do not own.");
        sb.AppendLine("    ///   3. Validation over the finished collection. Deliberately deferred to the end so");
        sb.AppendLine("    ///      every conflict is reported at once rather than failing on the first.");
        sb.AppendLine("    ///   4. IOverrideRegistrations contributors, each superseding what came before.");
        sb.AppendLine("    ///");
        sb.AppendLine("    /// A project referenced by two parents has AddRegistrations called twice, so its");
        sb.AppendLine("    /// registrations appear twice. That is a harmless repeat, not a conflict, and step 3");
        sb.AppendLine("    /// distinguishes them: identical descriptors are collapsed, differing ones throw.");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public static IServiceCollection ApplyRegistrations(IServiceCollection services, Assembly assembly) {");
        sb.AppendLine("        var types = assembly.GetTypes().Where(t => t is { IsClass: true, IsAbstract: false }).ToList();");
        sb.AppendLine();
        sb.AppendLine("        // 1. Attribute-declared registrations.");
        sb.AppendLine("        foreach (var type in types) {");
        sb.AppendLine("            foreach (var attribute in type.GetCustomAttributes<RegisterAttribute>()) {");
        sb.AppendLine("                var serviceType = attribute.ServiceType ?? type;");
        sb.AppendLine("                switch (attribute.Lifetime) {");
        sb.AppendLine("                    case ServiceLifetime.Singleton: services.AddSingleton(serviceType, type); break;");
        sb.AppendLine("                    case ServiceLifetime.Scoped:    services.AddScoped(serviceType, type); break;");
        sb.AppendLine("                    case ServiceLifetime.Transient: services.AddTransient(serviceType, type); break;");
        sb.AppendLine("                }");
        sb.AppendLine("            }");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        // 2. Contributors registering types they do not own.");
        sb.AppendLine("        foreach (var type in types.Where(t => typeof(IAddRegistrations).IsAssignableFrom(t))) {");
        sb.AppendLine("            var contributor = (IAddRegistrations)Activator.CreateInstance(type)!;");
        sb.AppendLine("            contributor.AddRegistrations(services);");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        // 3. Validate once, over the finished collection. A group whose descriptors are all");
        sb.AppendLine("        //    identical is the diamond-dependency repeat — collapse it. A group that differs");
        sb.AppendLine("        //    in implementation or lifetime is a genuine conflict.");
        sb.AppendLine("        var conflicts = services");
        sb.AppendLine("            .GroupBy(descriptor => descriptor.ServiceType)");
        sb.AppendLine("            .Where(group => group.Count() > 1)");
        sb.AppendLine("            .Where(group => group.Select(d => (d.ImplementationType, d.Lifetime)).Distinct().Count() > 1)");
        sb.AppendLine("            .ToList();");
        sb.AppendLine();
        sb.AppendLine("        if (conflicts.Count > 0) {");
        sb.AppendLine("            string detail = string.Join(Environment.NewLine, conflicts.Select(group =>");
        sb.AppendLine("                \"  \" + group.Key.FullName + \" -> \" +");
        sb.AppendLine("                string.Join(\", \", group.Select(d => (d.ImplementationType?.FullName ?? \"(factory)\") + \" (\" + d.Lifetime + \")\"))));");
        sb.AppendLine();
        sb.AppendLine("            throw new InvalidOperationException(");
        sb.AppendLine("                \"Conflicting DI registrations in '\" + assembly.GetName().Name + \"':\" + Environment.NewLine + detail + Environment.NewLine +");
        sb.AppendLine("                \"Use IOverrideRegistrations to replace a registration deliberately.\");");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        CollapseDuplicates(services);");
        sb.AppendLine();
        sb.AppendLine("        // 4. Overrides, each replacing whatever the same service type was registered as.");
        sb.AppendLine("        foreach (var type in types.Where(t => typeof(IOverrideRegistrations).IsAssignableFrom(t))) {");
        sb.AppendLine("            var contributor = (IOverrideRegistrations)Activator.CreateInstance(type)!;");
        sb.AppendLine("            contributor.ReplaceRegistrations(services);");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        CollapseDuplicates(services);");
        sb.AppendLine();
        sb.AppendLine("        return services;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>Keeps only the LAST descriptor for each service type — appends win, which");
        sb.AppendLine("    /// is what makes an override supersede what it replaces.</summary>");
        sb.AppendLine("    private static void CollapseDuplicates(IServiceCollection services) {");
        sb.AppendLine("        var groups = services");
        sb.AppendLine("            .GroupBy(descriptor => descriptor.ServiceType)");
        sb.AppendLine("            .Where(group => group.Count() > 1)");
        sb.AppendLine("            .ToList();");
        sb.AppendLine();
        sb.AppendLine("        foreach (var group in groups) {");
        sb.AppendLine("            foreach (var stale in group.Take(group.Count() - 1).ToList()) services.Remove(stale);");
        sb.AppendLine("        }");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return sb.ToString();
    }


    /// The hand-written companion to the generated ServiceCollectionExtensions. Created once
    /// with a commented example; never touched again, since it is where real registrations
    /// live. Deliberately has no .g.cs suffix — that suffix means "regenerated every run".
    private void WriteManualStubIfMissing(SolutionProject project, SolutionProject infrastructureProject, ref int written, ref int skipped) {
        string path = Path.Combine(project.ProjectDirectory, "ServiceCollectionExtensions.Manual.cs");

        if (File.Exists(path)) {
            Log("    ServiceCollectionExtensions.Manual.cs already exists — left untouched");
            skipped++;
            return;
        }

        File.WriteAllText(path, BuildManualStub(project, infrastructureProject));
        Log("    wrote ServiceCollectionExtensions.Manual.cs (stub)");
        written++;
    }

    private string BuildManualStub(SolutionProject project, SolutionProject infrastructureProject) {
        bool isInfrastructure = project.ProjectName.Equals(infrastructureProject.ProjectName, StringComparison.OrdinalIgnoreCase);
        string infrastructureUsing = isInfrastructure ? "" : "using " + infrastructureProject.RootNamespace + ";\n";

        var sb = new StringBuilder();
        sb.AppendLine("// Hand-written. Created once by the DISetup template and never regenerated —");
        sb.AppendLine("// edit freely.");
        sb.AppendLine();
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        if (!isInfrastructure) sb.AppendLine("using " + infrastructureProject.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("public static partial class ServiceCollectionExtensions {");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// Registrations the attribute scan cannot express. Called by the generated");
        sb.AppendLine("    /// AddRegistrations after this project's dependencies and its own scan have run.");
        sb.AppendLine("    ///");
        sb.AppendLine("    /// THREE WAYS TO REGISTER, and which to reach for:");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///   [Register] on the class — the default. Works when you own the type and it has");
        sb.AppendLine("    ///   a PUBLIC constructor, because the scan activates it by reflection:");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///       [Register]                                    // as itself, Singleton");
        sb.AppendLine("    ///       [Register(typeof(IThing))]                    // against an interface");
        sb.AppendLine("    ///       [Register(typeof(IThing), ServiceLifetime.Transient)]");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///   HERE — you own the type, but reflection cannot build it: a non-public");
        sb.AppendLine("    ///   constructor, an options lambda, a lifetime decided at runtime. A factory");
        sb.AppendLine("    ///   written here is compiled code in this assembly, so it can reach an internal");
        sb.AppendLine("    ///   or protected constructor that reflection cannot:");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///       services.AddSingleton<MainViewModel>(_ => new MainViewModel());");
        sb.AppendLine("    ///       services.AddDbContext<AppDbContext>(o => o.UseSqlServer(connectionString));");
        sb.AppendLine("    ///");
        sb.AppendLine("    ///   IAddRegistrations — you do NOT own the type and cannot decorate it: a");
        sb.AppendLine("    ///   scaffolded entity, generated code, something from a package. Implement the");
        sb.AppendLine("    ///   interface in its own class under DI/; the scan finds every implementation, so");
        sb.AppendLine("    ///   any number can coexist. This is the one most easily missed.");
        sb.AppendLine("    ///");
        sb.AppendLine("    /// To REPLACE a registration rather than add one — resolving a conflict, or");
        sb.AppendLine("    /// substituting in a test — see IOverrideRegistrations. See also");
        sb.AppendLine("    /// CoderFiles/README-DependencyInjection.md.");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    static partial void AddManualRegistrations(IServiceCollection services) {");
        sb.AppendLine();
        sb.AppendLine("        // Example — delete or replace:");
        sb.AppendLine("        // services.AddSingleton<SomeType>(_ => new SomeType());");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildServiceCollectionExtensions(SolutionProject project, List<SolutionProject> directDependencies, SolutionProject infrastructureProject) {
        bool isInfrastructure = project.ProjectName.Equals(infrastructureProject.ProjectName, StringComparison.OrdinalIgnoreCase);

        var sb = new StringBuilder();
        sb.Append(GeneratedBanner("DI entry point for this project."));
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine();
        sb.AppendLine("namespace " + project.RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("public static partial class ServiceCollectionExtensions {");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// Registers this project and everything it depends on. Direct dependencies only —");
        sb.AppendLine("    /// transitivity handles the rest. Calls are fully qualified with global:: because");
        sb.AppendLine("    /// every project declares a method of the same name, and a project whose own");
        sb.AppendLine("    /// namespace nests a segment matching a dependency's root would otherwise resolve");
        sb.AppendLine("    /// the call relative to itself.");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public static IServiceCollection AddRegistrations(this IServiceCollection services) {");

        if (directDependencies.Count == 0) {
            sb.AppendLine("        // No project dependencies — this is the deepest tier.");
        }
        else {
            foreach (var dependency in directDependencies)
                sb.AppendLine("        global::" + dependency.RootNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
        }

        sb.AppendLine();

        string scannerCall = isInfrastructure
            ? "RegistrationScanner.ApplyRegistrations(services, typeof(ServiceCollectionExtensions).Assembly);"
            : "global::" + infrastructureProject.RootNamespace + ".RegistrationScanner.ApplyRegistrations(services, typeof(ServiceCollectionExtensions).Assembly);";

        sb.AppendLine("        " + scannerCall);
        sb.AppendLine();
        sb.AppendLine("        // Hand-written registrations the attribute scan cannot express — a factory lambda,");
        sb.AppendLine("        // an internal constructor, a conditional lifetime. Implement in a separate file;");
        sb.AppendLine("        // if nothing implements it the call compiles away to nothing.");
        sb.AppendLine("        AddManualRegistrations(services);");
        sb.AppendLine();
        sb.AppendLine("        return services;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    static partial void AddManualRegistrations(IServiceCollection services);");
        sb.AppendLine("}");
        return sb.ToString();
    }

    /// The DI documentation, written beside the arguments file. Overwritten every run:
    /// unlike the Manual.cs stubs nobody edits this, and a stale copy describing a
    /// mechanism that has since changed is worse than none.
    private string BuildReadme(SolutionProject infrastructureProject, List<SolutionProject> projects) {
        string infraName = infrastructureProject.ProjectName;
        string infraNamespace = infrastructureProject.RootNamespace;
        string entryNamespace = projects.First(p => p.Tier == 1).RootNamespace;

        var sb = new StringBuilder();
        sb.AppendLine("# Dependency Injection");
        sb.AppendLine("");
        sb.AppendLine("Generated by the DISetup template. This file is overwritten on every run — it documents");
        sb.AppendLine("the mechanism as it currently stands, so edits here are lost. Your own registrations live");
        sb.AppendLine("in each project's `ServiceCollectionExtensions.Manual.cs`, which is never regenerated.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## How the wiring fits together");
        sb.AppendLine("");
        sb.AppendLine("Every project has a generated `DI/ServiceCollectionExtensions.g.cs` declaring one method:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("public static IServiceCollection AddRegistrations(this IServiceCollection services)");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("It does three things, in order: calls `AddRegistrations` on each project it directly");
        sb.AppendLine("depends on, runs the registration scan over its own assembly, then calls");
        sb.AppendLine("`AddManualRegistrations` — the hand-written seam.");
        sb.AppendLine("");
        sb.AppendLine("Because each project cascades into its direct dependencies, the composition root only");
        sb.AppendLine("calls the entry point. In a WPF application that is `App.xaml.cs`:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("protected override void OnStartup(StartupEventArgs e) {");
        sb.AppendLine("");
        sb.AppendLine("    // The collection is a local: it exists only long enough to build the provider,");
        sb.AppendLine("    // and ServiceLocator holds the result for the life of the process.");
        sb.AppendLine("    var services = new ServiceCollection();");
        sb.AppendLine("    " + entryNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
        sb.AppendLine("    " + infraNamespace + ".ServiceLocator.Initialize(services.BuildServiceProvider());");
        sb.AppendLine("");
        sb.AppendLine("    // Nothing may resolve before Initialize has run — CurrentProvider throws until then.");
        sb.AppendLine("    var mainView = " + infraNamespace + ".ServiceLocator.CurrentProvider.GetRequiredService<MainView>();");
        sb.AppendLine("    mainView.Show();");
        sb.AppendLine("");
        sb.AppendLine("    base.OnStartup(e);");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("`MainView` has to be registered for that last resolve to succeed. A window has a public");
        sb.AppendLine("constructor, so the attribute is enough:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("[Register]");
        sb.AppendLine("public partial class MainView : Window { }");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Without it, `GetRequiredService<MainView>()` throws *No service for type ... has been");
        sb.AppendLine("registered* at startup. The same applies to anything else resolved here.");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Three things about that sequence are load-bearing:");
        sb.AppendLine("");
        sb.AppendLine("- **`AddRegistrations` is called on the entry-point project only.** It cascades into");
        sb.AppendLine("  everything else. Calling it on several projects is harmless but redundant.");
        sb.AppendLine("- **`Initialize` comes after `BuildServiceProvider`,** and before anything resolves.");
        sb.AppendLine("  `CurrentProvider` throws until it has run, naming its own cause.");
        sb.AppendLine("- **The window is resolved, not constructed.** `new MainView()` would bypass the");
        sb.AppendLine("  container and leave its dependencies unwired.");
        sb.AppendLine("");
        sb.AppendLine("A console or service host differs only in what it resolves at the end; the three lines");
        sb.AppendLine("before that are the same.");
        sb.AppendLine("");
        sb.AppendLine("A project referenced by two others has `AddRegistrations` called twice. That is harmless:");
        sb.AppendLine("the scan detects identical repeats and collapses them.");
        sb.AppendLine("");
        sb.AppendLine("The shared components — the attribute, the interfaces, the scanner, the locator — are");
        sb.AppendLine("generated once into **" + infraName + "**, the deepest project, which every other project");
        sb.AppendLine("already references transitively.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## Registering a type");
        sb.AppendLine("");
        sb.AppendLine("Three mechanisms, chosen by who owns the type and whether reflection can construct it.");
        sb.AppendLine("");
        sb.AppendLine("### `[Register]` — the default");
        sb.AppendLine("");
        sb.AppendLine("You own the type and it has a **public** constructor.");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("[Register]                                              // as itself, Singleton");
        sb.AppendLine("[Register(typeof(IThing))]                              // against an interface");
        sb.AppendLine("[Register(typeof(IThing), ServiceLifetime.Transient)]   // and a lifetime");
        sb.AppendLine("public class Thing : IThing { }");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("`AllowMultiple`, so one class can be resolvable under several interfaces.");
        sb.AppendLine("");
        sb.AppendLine("The public constructor matters: the scan activates types by reflection, which cannot reach");
        sb.AppendLine("an `internal` or `protected` constructor. A type with one needs the next mechanism.");
        sb.AppendLine("");
        sb.AppendLine("### `AddManualRegistrations` — you own it, reflection cannot build it");
        sb.AppendLine("");
        sb.AppendLine("In `{Project}/ServiceCollectionExtensions.Manual.cs`. A factory written there is compiled");
        sb.AppendLine("code in the same assembly, so it reaches a non-public constructor that reflection cannot.");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("static partial void AddManualRegistrations(IServiceCollection services) {");
        sb.AppendLine("    services.AddSingleton<MainViewModel>(_ => new MainViewModel());");
        sb.AppendLine("    services.AddDbContext<AppDbContext>(o => o.UseSqlServer(connectionString));");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Use it for a non-public constructor, an options lambda, or a lifetime decided at runtime.");
        sb.AppendLine("");
        sb.AppendLine("This file is created once by DISetup and never regenerated.");
        sb.AppendLine("");
        sb.AppendLine("### `IAddRegistrations` — you do not own the type");
        sb.AppendLine("");
        sb.AppendLine("A scaffolded entity, generated code, something from a package — anything you cannot");
        sb.AppendLine("decorate. Implement the interface in its own class under `DI/`:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("public class EntityLoaderRegistrations : IAddRegistrations {");
        sb.AppendLine("    public void AddRegistrations(IServiceCollection services) {");
        sb.AppendLine("        foreach (var type in Assembly.GetExecutingAssembly().GetTypes()) {");
        sb.AppendLine("            // ...register whatever matches...");
        sb.AppendLine("        }");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("The scan finds every implementation, so any number can coexist — several code generators");
        sb.AppendLine("can contribute to one project without colliding. Implementations need a public");
        sb.AppendLine("parameterless constructor.");
        sb.AppendLine("");
        sb.AppendLine("This is the mechanism most easily missed, and the answer whenever the type you want to");
        sb.AppendLine("register is one you cannot edit.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## Replacing a registration");
        sb.AppendLine("");
        sb.AppendLine("The three above all *add*. Replacing is a separate concern, and has its own interface.");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("public class TestSubstitutions : IOverrideRegistrations {");
        sb.AppendLine("    public void ReplaceRegistrations(IServiceCollection services) {");
        sb.AppendLine("        services.AddTransient<IClock, FixedClock>();");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Overrides run last, after the scan and after every `IAddRegistrations` contributor, and");
        sb.AppendLine("are exempt from duplicate validation — replacing is the declared intent. Use plain `Add*`");
        sb.AppendLine("calls; the scanner removes whatever the same service type was registered as before.");
        sb.AppendLine("");
        sb.AppendLine("Two uses: resolving a conflict between independently generated registrations, and");
        sb.AppendLine("substituting behaviour in a test project.");
        sb.AppendLine("");
        sb.AppendLine("### When registrations conflict");
        sb.AppendLine("");
        sb.AppendLine("If two sources register the same service type differently, the scan throws and lists every");
        sb.AppendLine("conflict at once:");
        sb.AppendLine("");
        sb.AppendLine("```");
        sb.AppendLine("Conflicting DI registrations in 'MyProject':");
        sb.AppendLine("  MyProject.IThing -> MyProject.ThingA (Singleton), MyProject.ThingB (Singleton)");
        sb.AppendLine("Use IOverrideRegistrations to replace a registration deliberately.");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Identical repeats are not conflicts — those come from the same project being reached twice");
        sb.AppendLine("through the dependency graph, and are collapsed silently.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## The service locator");
        sb.AppendLine("");
        sb.AppendLine("A type should receive its **business domain** dependencies through its constructor —");
        sb.AppendLine("the ones without which it would not be in a valid state.[^1] Those belong in the");
        sb.AppendLine("signature, where the compiler enforces them and a reader can see what the type needs.");
        sb.AppendLine("");
        sb.AppendLine("Two other kinds of dependency do not belong there.");
        sb.AppendLine("");
        sb.AppendLine("**Those that cannot be injected.** A static `Instance` property has no constructor to");
        sb.AppendLine("inject into. A view constructed by XAML is built by the framework, not the container. A");
        sb.AppendLine("design-time fallback runs in a process where no container was ever built.[^2]");
        sb.AppendLine("");
        sb.AppendLine("**Those that should not be injected.** Infrastructure a type merely *uses* rather than");
        sb.AppendLine("*is defined by* — a logger, a connection, a performance counter — is not part of what");
        sb.AppendLine("makes an instance valid. Threading it through every constructor adds a parameter to");
        sb.AppendLine("every type and a line to every call site, obscuring the dependencies that do matter.");
        sb.AppendLine("Lazily instantiated properties are the same case: the point is to defer the cost until");
        sb.AppendLine("something asks, which a constructor parameter defeats.[^3]");
        sb.AppendLine("");
        sb.AppendLine("For both, resolve at the point of use:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("// Infrastructure — used, not definitional. Resolved per access, not stored.");
        sb.AppendLine("private ILogger Logger => " + infraNamespace + ".ServiceLocator.CurrentProvider.GetRequiredService<ILogger>();");
        sb.AppendLine("");
        sb.AppendLine("// Lazy property — the cost is paid on first read, not on construction.");
        sb.AppendLine("private IReportBuilder Builder => field ??= " + infraNamespace + ".ServiceLocator.CurrentProvider.GetRequiredService<IReportBuilder>();");
        sb.AppendLine("");
        sb.AppendLine("// Static Instance — no constructor to inject into.");
        sb.AppendLine("public static MainModel Instance => DesignTimeSingleton<MainModel>.Resolve(() => new MainModel());");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("`Initialize` is called once at startup. `CurrentProvider` throws rather than returning");
        sb.AppendLine("null when nothing has been initialized, so the failure names its own cause.");
        sb.AppendLine("");
        sb.AppendLine("The line to hold: if a dependency defines what the type *is*, it goes in the");
        sb.AppendLine("constructor. If it is something the type *uses*, the locator is the better place.");
        sb.AppendLine("");
        sb.AppendLine("[^1]: A repository an order service cannot function without; a validator a form is");
        sb.AppendLine("    meaningless without. Constructing one of these without its dependency should be");
        sb.AppendLine("    impossible, which is exactly what a constructor parameter guarantees.");
        sb.AppendLine("");
        sb.AppendLine("[^2]: See `DesignTimeSingleton`, which resolves from the container and falls back to a");
        sb.AppendLine("    directly constructed instance only when the process is the XAML designer's — so a");
        sb.AppendLine("    resolution failure in production or in a test still propagates as a real bug.");
        sb.AppendLine("");
        sb.AppendLine("[^3]: `field ??=` in a property getter resolves once, on first access, and caches. A");
        sb.AppendLine("    constructor parameter would resolve for every instance whether or not anything");
        sb.AppendLine("    ever reads it.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## Testing");
        sb.AppendLine("");
        sb.AppendLine("### The problem");
        sb.AppendLine("");
        sb.AppendLine("A `ServiceCollection` is an ordinary object, so building one per test gives complete");
        sb.AppendLine("isolation for free. But code reached *through the locator* — anything calling");
        sb.AppendLine("`SomeType.Instance` — does not resolve from your provider. It resolves from whatever");
        sb.AppendLine("`ServiceLocator` currently holds, which without care means whatever the last test set.");
        sb.AppendLine("");
        sb.AppendLine("### Most tests need nothing special");
        sb.AppendLine("");
        sb.AppendLine("If the code under test receives its dependencies through its constructor, resolve directly");
        sb.AppendLine("and ignore the locator entirely:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("var services = new ServiceCollection();");
        sb.AppendLine("" + entryNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
        sb.AppendLine("var provider = services.BuildServiceProvider();");
        sb.AppendLine("");
        sb.AppendLine("var thing = provider.GetRequiredService<IThing>();");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("No scoping, no cleanup beyond disposing the provider. Prefer this.");
        sb.AppendLine("");
        sb.AppendLine("### When the code calls `.Instance`");
        sb.AppendLine("");
        sb.AppendLine("Then the locator has to point at your container for the duration of the test:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("using (ServiceLocator.UseProvider(provider)) {");
        sb.AppendLine("    var model = MainModel.Instance;   // resolves from YOUR provider");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("Disposing restores whatever was in effect before, so nested and sequential scopes both");
        sb.AppendLine("behave. The scope uses `AsyncLocal` rather than `[ThreadStatic]`: a thread-static value");
        sb.AppendLine("does not survive an `await` — the continuation can resume on a different pool thread — so");
        sb.AppendLine("an async test would silently fall back to the default provider.");
        sb.AppendLine("");
        sb.AppendLine("### Substituting a registration");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("var services = new ServiceCollection();");
        sb.AppendLine("" + entryNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
        sb.AppendLine("services.Replace(ServiceDescriptor.Transient<IClock, FixedClock>());");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("`Replace` after `AddRegistrations`, not before: it matches on service type regardless of");
        sb.AppendLine("how the original was registered, so it supersedes even a factory registration. One");
        sb.AppendLine("statement rather than a remove followed by an add, so there is no stale descriptor to");
        sb.AppendLine("leave behind if the removal misses.");
        sb.AppendLine("");
        sb.AppendLine("`Microsoft.Extensions.DependencyInjection.Extensions` provides `Replace` and `RemoveAll`.");
        sb.AppendLine("");
        sb.AppendLine("### Composing the pieces");
        sb.AppendLine("");
        sb.AppendLine("A base class layers suite-wide substitutions under per-test ones:");
        sb.AppendLine("");
        sb.AppendLine("```csharp");
        sb.AppendLine("public abstract class TestBase {");
        sb.AppendLine("");
        sb.AppendLine("    protected ServiceProvider Provider { get; private set; } = null!;");
        sb.AppendLine("    private IDisposable? _scope;");
        sb.AppendLine("");
        sb.AppendLine("    [TestInitialize] public void Initialize() => BuildProvider(null);");
        sb.AppendLine("    [TestCleanup]    public void Teardown()   => ReleaseProvider();");
        sb.AppendLine("");
        sb.AppendLine("    /// Suite-wide registrations. Derived classes call base first, then layer their own.");
        sb.AppendLine("    protected virtual void ConfigureServices(IServiceCollection services) {");
        sb.AppendLine("        " + entryNamespace + ".ServiceCollectionExtensions.AddRegistrations(services);");
        sb.AppendLine("    }");
        sb.AppendLine("");
        sb.AppendLine("    protected void RebuildProviderWithOverrides(Action<IServiceCollection> overrides) {");
        sb.AppendLine("        ReleaseProvider();");
        sb.AppendLine("        BuildProvider(overrides);");
        sb.AppendLine("    }");
        sb.AppendLine("");
        sb.AppendLine("    private void BuildProvider(Action<IServiceCollection>? overrides) {");
        sb.AppendLine("        var services = new ServiceCollection();");
        sb.AppendLine("        ConfigureServices(services);");
        sb.AppendLine("        overrides?.Invoke(services);");
        sb.AppendLine("");
        sb.AppendLine("        Provider = services.BuildServiceProvider();");
        sb.AppendLine("        _scope = ServiceLocator.UseProvider(Provider);");
        sb.AppendLine("    }");
        sb.AppendLine("");
        sb.AppendLine("    private void ReleaseProvider() {");
        sb.AppendLine("        // Provider FIRST. Disposing it disposes the services it created, and their Dispose");
        sb.AppendLine("        // methods may resolve through the locator — releasing the scope first would leave");
        sb.AppendLine("        // them with no provider to reach.");
        sb.AppendLine("        Provider?.Dispose();");
        sb.AppendLine("        _scope?.Dispose();");
        sb.AppendLine("        _scope = null;");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        sb.AppendLine("```");
        sb.AppendLine("");
        sb.AppendLine("That disposal order is not obvious until it bites: a service whose `Dispose` touches");
        sb.AppendLine("`.Instance` throws during teardown if the scope has already gone.");
        sb.AppendLine("");
        sb.AppendLine("One related trap: a lazy property read from inside `Dispose` **constructs** the object it");
        sb.AppendLine("is trying to dispose. Read the backing field there, not the property.");
        sb.AppendLine("");
        sb.AppendLine("---");
        sb.AppendLine("");
        sb.AppendLine("## Files");
        sb.AppendLine("");
        sb.AppendLine("Generated, overwritten every run:");
        sb.AppendLine("");
        sb.AppendLine("| File | Where |");
        sb.AppendLine("|---|---|");
        sb.AppendLine("| `RegisterAttribute.g.cs` | `" + infraName + "/DI/` |");
        sb.AppendLine("| `IAddRegistrations.g.cs` | `" + infraName + "/DI/` |");
        sb.AppendLine("| `IOverrideRegistrations.g.cs` | `" + infraName + "/DI/` |");
        sb.AppendLine("| `ServiceLocator.g.cs` | `" + infraName + "/DI/` |");
        sb.AppendLine("| `RegistrationScanner.g.cs` | `" + infraName + "/DI/` |");
        sb.AppendLine("| `ServiceCollectionExtensions.g.cs` | every project's `DI/` |");
        sb.AppendLine("");
        sb.AppendLine("Created once, then yours:");
        sb.AppendLine("");
        sb.AppendLine("| File | Where |");
        sb.AppendLine("|---|---|");
        sb.AppendLine("| `ServiceCollectionExtensions.Manual.cs` | every project's root |");
        sb.AppendLine("");
        sb.AppendLine("Hand-written, wherever you put them: `IAddRegistrations` and `IOverrideRegistrations`");
        sb.AppendLine("implementations, conventionally under `DI/`.");
        sb.AppendLine("");
        sb.AppendLine("Test projects are skipped entirely.");
        return sb.ToString();
    }

#>
