<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ include file="../Shared/TemplateArguments.ttinclude" #>
<#@ include file="../Shared/TemplateLog.ttinclude" #>
<#
    // ============================================================
    // ARGUMENTS (read from {SolutionRoot}\CoderFiles\PlanSetup.args.txt)
    //
    //   SolutionFilePath  (required) — full path to the .slnx/.sln this Setup targets.
    //
    // Coder.App writes this file before every invocation. To run this template manually
    // from inside a solution, create the file by hand with the same key.
    // ============================================================

    if (!HasArguments) {
        LogError($"No arguments file found. Looked at: {ArgumentsFilePathForDiagnostics}", null);
        return string.Empty;
    }

    string solutionFilePath = GetArgument("SolutionFilePath");
    if (string.IsNullOrWhiteSpace(solutionFilePath)) {
        LogError($"SolutionFilePath is missing from {ArgumentsFilePathForDiagnostics}", null);
        return string.Empty;
    }

    Log($"Arguments file  : {ArgumentsFilePathForDiagnostics}");
    Log($"SolutionFilePath: {solutionFilePath}");
    Log($"Solution exists : {File.Exists(solutionFilePath)}");

    if (!File.Exists(solutionFilePath)) {
        LogError($"Solution file does not exist: {solutionFilePath}", null);
        return string.Empty;
    }

    string solutionRoot = Path.GetDirectoryName(solutionFilePath) ?? string.Empty;

    string testsProjectRoot = FindTestsProjectRoot(solutionRoot);
    if (string.IsNullOrWhiteSpace(testsProjectRoot)) {
        LogError($"Could not find a *Tests folder under {solutionRoot}", solutionFilePath);
        return string.Empty;
    }

    Log($"Tests project   : {testsProjectRoot}");

    var sb = new StringBuilder();
    sb.AppendLine("Setup probe ran successfully.");
    sb.AppendLine($"Timestamp:        {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
    sb.AppendLine($"Arguments file:   {ArgumentsFilePathForDiagnostics}");
    sb.AppendLine($"SolutionFilePath: {solutionFilePath}");
    sb.AppendLine($"Solution root:    {solutionRoot}");
    sb.AppendLine($"Tests project:    {testsProjectRoot}");

    string markerPath = Path.Combine(testsProjectRoot, "SetupProbe.marker.txt");
    File.WriteAllText(markerPath, sb.ToString());
    Log($"Marker written  : {markerPath}");

    FlushLog(solutionFilePath);

    Write($"Setup probe complete. Marker: {markerPath}");
#>
<#+
    // Required by TemplateArguments.ttinclude and TemplateLog.ttinclude: under the t4 CLI,
    // Host.TemplateFile is empty, so the template cannot discover its own name. Every
    // template using these includes must declare this.
    private string TemplateNameFallback { get { return "PlanSetup"; } }

    private string FindTestsProjectRoot(string solutionRoot) {
        if (!Directory.Exists(solutionRoot)) return string.Empty;

        foreach (string directory in Directory.GetDirectories(solutionRoot, "*", SearchOption.AllDirectories)) {
            string name = Path.GetFileName(directory);
            if (name.Equals("bin", StringComparison.OrdinalIgnoreCase) ||
                name.Equals("obj", StringComparison.OrdinalIgnoreCase) ||
                name.StartsWith(".", StringComparison.Ordinal)) continue;

            if (name.EndsWith("Tests", StringComparison.OrdinalIgnoreCase) &&
                Directory.GetFiles(directory, "*.csproj").Length > 0) {
                return directory;
            }
        }

        return string.Empty;
    }
#>