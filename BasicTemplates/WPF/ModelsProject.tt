<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Memory" #>
<#@ assembly name="Microsoft.CodeAnalysis" #>
<#@ assembly name="Microsoft.CodeAnalysis.CSharp" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="Microsoft.CodeAnalysis.CSharp" #>
<#@ import namespace="Microsoft.CodeAnalysis.CSharp.Syntax" #>
<#@ parameter name="MetadataFilePath" type="System.String" #>
<#@ parameter name="TargetDirectory" type="System.String" #>
<#@ include file="../Shared/TemplateLog.ttinclude" #>
<#@ include file="../Shared/SolutionGraph.ttinclude" #>
<#@ include file="../Shared/TargetFolders.ttinclude" #>
<#
    // ============================================================
    // FILE FILTERS
    // ============================================================
    var Filters = new[] {
        new FileFilterRule {
            NamePatterns = new[] { "*.cs" },
            ExcludeNamePatterns = new[] { "*.Designer.cs", "*.g.cs" },
            ExcludedBaseTypes = new[] { "DbContext" }
        }
    };

    // ============================================================
    // TARGET FOLDERS
    // ============================================================
    var TargetFolders = new[] {
        new TargetFolder("Interfaces",  "Interfaces"),
        new TargetFolder("Collections", "Services")
    };

    if (string.IsNullOrWhiteSpace(MetadataFilePath) || !File.Exists(MetadataFilePath))
    {
        LogError("MetadataFilePath is missing or invalid.", null);
        return string.Empty;
    }
    if (string.IsNullOrWhiteSpace(TargetDirectory))
    {
        LogError("TargetDirectory was not provided.", null);
        return string.Empty;
    }

    string solutionFilePath = FindSolutionFile(TargetDirectory);
    if (string.IsNullOrWhiteSpace(solutionFilePath))
    {
        LogError("No .slnx or .sln found above " + TargetDirectory + ". Generated code must live inside a solution.", null);
        return string.Empty;
    }

    Log("Solution        : " + solutionFilePath);
    Log("TargetDirectory : " + TargetDirectory);

    BuildSolutionGraph(solutionFilePath);
    foreach (string diagnostic in GraphDiagnostics) Log("GRAPH: " + diagnostic);

    var productionProjects = ProductionProjectsByTier();
    if (productionProjects.Count == 0)
    {
        LogError("No production projects found in the solution.", solutionFilePath);
        return string.Empty;
    }

    var infrastructureProject = productionProjects.Last();
    string serviceLocatorPath = FindServiceLocator(infrastructureProject);
    if (string.IsNullOrWhiteSpace(serviceLocatorPath))
    {
        LogError(
            "ServiceLocator was not found in " + infrastructureProject.ProjectName + ". " +
            "Run the DISetup template first — generated entities resolve their loaders through it.",
            solutionFilePath);
        return string.Empty;
    }

    string DiResolverUsing = infrastructureProject.RootNamespace;
    string DiResolverExpression = infrastructureProject.RootNamespace + ".ServiceLocator.CurrentProvider";

    Log("Infrastructure  : " + infrastructureProject.ProjectName + " (tier " + infrastructureProject.Tier + ")");
    Log("ServiceLocator  : " + MakeRelativePath(SolutionDirectory, serviceLocatorPath));

    string metadataJson = File.ReadAllText(MetadataFilePath);
    using var document = JsonDocument.Parse(metadataJson);
    var root = document.RootElement;
    string namespaceName = ComputeNamespace(TargetDirectory);

    var entityProject = FindProjectContaining(TargetDirectory);
    if (entityProject == null)
    {
        LogError("TargetDirectory is not inside any project listed in the solution: " + TargetDirectory, solutionFilePath);
        return string.Empty;
    }

    string entityInterfacesFolder = ResolveTargetFolder(TargetFolders, "Interfaces", entityProject);
    string EntityInterfacesNamespace = ComputeNamespace(entityInterfacesFolder);
    File.WriteAllText(Path.Combine(entityInterfacesFolder, "IEntitySetLoader.g.cs"), BuildEntityInterfaces(EntityInterfacesNamespace));
    Log("Wrote " + MakeRelativePath(SolutionDirectory, entityInterfacesFolder) + "\\IEntitySetLoader.g.cs  (namespace " + EntityInterfacesNamespace + ")");

    string collectionsFolder = ResolveTargetFolder(TargetFolders, "Collections", infrastructureProject);
    string CollectionsNamespace = ComputeNamespace(collectionsFolder);
    File.WriteAllText(Path.Combine(collectionsFolder, "LiveFilteredCollection.g.cs"), BuildLiveFilteredCollection(CollectionsNamespace));
    Log("Wrote " + MakeRelativePath(SolutionDirectory, collectionsFolder) + "\\LiveFilteredCollection.g.cs  (namespace " + CollectionsNamespace + ")");
    string mainModelNamespace = GetProjectRootNamespace(TargetDirectory);

    if (!root.TryGetProperty("Files", out var filesElement))
    {
        Write("Error: metadata does not contain a Files array.");
        return string.Empty;
    }

    int filesWritten = 0, filesDeleted = 0, skippedCount = 0, undetectedRelationships = 0;

    foreach (var fileEntry in filesElement.EnumerateArray())
    {
        string sourceFileName = fileEntry.GetProperty("SourceFileName").GetString()!;
        string sourceDirectory = fileEntry.GetProperty("SourceDirectory").GetString()!;
        string changeType = fileEntry.GetProperty("ChangeType").GetString()!;

        if (!ShouldProcess(Filters, $"{sourceFileName}.cs", changeType, () => GetBaseTypesForFile(sourceDirectory, sourceFileName)))
        {
            skippedCount++;
            continue;
        }

        string outputPath = Path.Combine(TargetDirectory, $"{sourceFileName}.g.cs");

        if (fileEntry.TryGetProperty("OldSourceFileName", out var oldNameEl) && oldNameEl.ValueKind != JsonValueKind.Null)
        {
            string oldName = oldNameEl.GetString();
            if (!string.IsNullOrWhiteSpace(oldName) && oldName != sourceFileName)
            {
                string oldOutputPath = Path.Combine(TargetDirectory, $"{oldName}.g.cs");
                if (File.Exists(oldOutputPath)) { File.Delete(oldOutputPath); filesDeleted++; }
            }
        }

        if (changeType == "Deleted")
        {
            if (File.Exists(outputPath)) { File.Delete(outputPath); filesDeleted++; }
            continue;
        }

        string sourceFilePath = Path.Combine(sourceDirectory, $"{sourceFileName}.cs");
        if (!File.Exists(sourceFilePath)) continue;

        var tree = CSharpSyntaxTree.ParseText(File.ReadAllText(sourceFilePath));
        var syntaxRoot = tree.GetRoot();
        var classDecl = syntaxRoot.DescendantNodes().OfType<ClassDeclarationSyntax>().FirstOrDefault();
        if (classDecl == null) continue;

        string entityName = classDecl.Identifier.Text;

        var scalarProps = new List<(string Name, string Type)>();
        var navProps = new List<(string PropertyName, string TargetType)>();
        var childProps = new List<(string PropertyName, string ChildType)>();

        foreach (var prop in classDecl.DescendantNodes().OfType<PropertyDeclarationSyntax>())
        {
            // FIX: Ignore static properties using raw text matching
            if (prop.Modifiers.Any(m => m.Text == "static")) continue;

            // FIX: Ignore expression-bodied properties (get-only)
            if (prop.ExpressionBody != null) continue;

            // FIX: Ignore properties that explicitly lack a setter or init
            if (prop.AccessorList != null && !prop.AccessorList.Accessors.Any(a => 
                a.Keyword.Text == "set" || 
                a.Keyword.Text == "init")) continue;

            string propName = prop.Identifier.Text;
            string typeText = prop.Type.ToString().Trim();

            var collectionMatch = Regex.Match(typeText, @"^(?:ICollection|IList|List|IEnumerable|ObservableCollection)<\s*([A-Za-z_][A-Za-z0-9_]*)\s*>$");
            if (collectionMatch.Success)
            {
                string elementType = collectionMatch.Groups[1].Value;
                if (!IsScalarType(elementType)) { childProps.Add((propName, elementType)); continue; }
            }

            if (IsEntityLikeType(typeText))
            {
                navProps.Add((propName, typeText.TrimEnd('?')));
                continue;
            }

            scalarProps.Add((propName, typeText));
        }

        string pkName = scalarProps.Any(p => p.Name == "Id") ? "Id" : (scalarProps.Count > 0 ? scalarProps[0].Name : "Id");
        string plural = Pluralize(entityName);
        string collectionFieldName = "_" + char.ToLower(plural[0]) + plural.Substring(1);

        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine($"//     Generated from {sourceFileName}.cs by the ModelsProject template.");
        sb.AppendLine("//     Regenerated whenever the source file changes.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("#nullable enable");
        sb.AppendLine();
        sb.AppendLine("#pragma warning disable IDE0130 // Namespace does not match folder structure");
        sb.AppendLine();
        sb.AppendLine("using System;");
        sb.AppendLine("using System.Linq;");
        sb.AppendLine("using System.Collections.ObjectModel;");
        sb.AppendLine("using System.Threading;");
        sb.AppendLine("using System.Threading.Tasks;");
        sb.AppendLine("using Microsoft.Extensions.DependencyInjection;");
        sb.AppendLine("using CommunityToolkit.Mvvm.ComponentModel;");
        sb.AppendLine($"using {EntityInterfacesNamespace};");
        sb.AppendLine($"using {CollectionsNamespace};");
        sb.AppendLine($"using {DiResolverUsing};");
        sb.AppendLine();
        sb.AppendLine($"namespace {namespaceName}");
        sb.AppendLine("{");
        sb.AppendLine($"public partial class {entityName} : ModelEntityBase");
        sb.AppendLine("{");

        foreach (var (name, type) in scalarProps)
        {
            string fieldName = "_" + char.ToLower(name[0]) + name.Substring(1);
            sb.AppendLine("    [ObservableProperty]");
            bool needsNullForgiving = !type.EndsWith("?") && ReferenceScalarTypes.Contains(type);
            sb.AppendLine(needsNullForgiving ? $"    private {type} {fieldName} = null!;" : $"    private {type} {fieldName};");
            sb.AppendLine();
        }

        foreach (var (propName, targetType) in navProps)
        {
            var pair = DetectForeignKeyPair(sourceDirectory, targetType, entityName);
            if (pair == null)
            {
                undetectedRelationships++;
                sb.AppendLine($"    // TODO: could not auto-detect the foreign key for '{propName}' -> {targetType}.");
                sb.AppendLine($"    // Add a manual implementation in a separate partial file, e.g.:");
                sb.AppendLine($"    // public {targetType}? {propName} => MainModel.Instance.{Pluralize(targetType)}.FirstOrDefault(x => /* match condition */);");
                sb.AppendLine();
                continue;
            }
            var (childFk, parentKey) = pair.Value;
            sb.AppendLine($"    public {targetType}? {propName} => MainModel.Instance.{Pluralize(targetType)}.FirstOrDefault(x => x.{parentKey} == this.{childFk});");
            sb.AppendLine();
        }

        foreach (var (propName, childType) in childProps)
        {
            var pair = DetectForeignKeyPair(sourceDirectory, entityName, childType);
            string backingField = "_" + char.ToLower(propName[0]) + propName.Substring(1);
            sb.AppendLine($"    private ObservableCollection<{childType}>? {backingField};");
            sb.AppendLine($"    public ObservableCollection<{childType}> {propName}");
            sb.AppendLine("    {");
            if (pair != null)
            {
                var (childFk, parentKey) = pair.Value;
                sb.AppendLine($"        get {{ if ({backingField} == null) {propName} = new LiveFilteredCollection<{childType}>(MainModel.Instance.{Pluralize(childType)}, x => x.{childFk} == this.{parentKey}, nameof({childType}.{childFk})); return {backingField}!; }}");
            }
            else
            {
                undetectedRelationships++;
                sb.AppendLine($"        // TODO: could not auto-detect the foreign key linking {childType} back to {entityName}.");
                sb.AppendLine($"        // Example: new LiveFilteredCollection<{childType}>(MainModel.Instance.{Pluralize(childType)}, x => /* match condition */, nameof({childType}.SomeProperty))");
                sb.AppendLine($"        get {{ if ({backingField} == null) {propName} = new ObservableCollection<{childType}>(); return {backingField}!; }}");
            }
            sb.AppendLine($"        private set => SetProperty(ref {backingField}, value);");
            sb.AppendLine("    }");
            sb.AppendLine();
        }

        sb.AppendLine($"    public static bool Is{plural}Loaded => MainModel.Instance.Is{plural}Loaded;");
        sb.AppendLine();
        sb.AppendLine($"    public static Task LoadAllAsync(CancellationToken ct = default) =>");
        sb.AppendLine($"        Is{plural}Loaded ? Task.CompletedTask : RefreshAllAsync(ct);");
        sb.AppendLine();
        sb.AppendLine($"    public static async Task RefreshAllAsync(CancellationToken ct = default)");
        sb.AppendLine("    {");
        sb.AppendLine("        OnRefreshing();");
        sb.AppendLine($"        var loader = {DiResolverExpression}.GetRequiredService<IEntitySetLoader<{entityName}>>();");
        sb.AppendLine("        var fresh = await loader.LoadAllAsync(ct);");
        sb.AppendLine();
        sb.AppendLine($"        ((ObservableRangeCollection<{entityName}>)MainModel.Instance.{plural}).ReplaceRange(fresh);");
        sb.AppendLine();
        sb.AppendLine($"        MainModel.Instance.Is{plural}Loaded = true;");
        sb.AppendLine("        OnRefreshed();");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    public static void UnloadAll()");
        sb.AppendLine("    {");
        sb.AppendLine("        OnUnloading();");
        sb.AppendLine($"        MainModel.Instance.Unload{plural}Storage();");
        sb.AppendLine("        OnUnloaded();");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    static partial void OnRefreshing();");
        sb.AppendLine("    static partial void OnRefreshed();");
        sb.AppendLine("    static partial void OnUnloading();");
        sb.AppendLine("    static partial void OnUnloaded();");
        sb.AppendLine();

        sb.AppendLine($"    internal void CopyScalarsFrom({entityName} fresh)");
        sb.AppendLine("    {");
        foreach (var (name, _) in scalarProps) sb.AppendLine($"        {name} = fresh.{name};");
        sb.AppendLine("    }");
        sb.AppendLine();

        sb.AppendLine("    protected override Task OnSaveAsync(CancellationToken ct) =>");
        sb.AppendLine($"        {DiResolverExpression}.GetRequiredService<IEntitySaver<{entityName}>>().SaveAsync(this, ct);");

        sb.AppendLine("}");
        sb.AppendLine("}");
        sb.AppendLine();

        sb.AppendLine($"namespace {mainModelNamespace}");
        sb.AppendLine("{");
        if (mainModelNamespace != namespaceName) sb.AppendLine($"using {namespaceName};");
        sb.AppendLine("public partial class MainModel");
        sb.AppendLine("{");
        sb.AppendLine($"    private ObservableRangeCollection<{entityName}>? {collectionFieldName};");
        sb.AppendLine($"    public ObservableRangeCollection<{entityName}> {plural}");
        sb.AppendLine("    {");
        sb.AppendLine($"        get {{ if ({collectionFieldName} == null) {plural} = new ObservableRangeCollection<{entityName}>(); return {collectionFieldName}!; }}");
        sb.AppendLine($"        private set => SetProperty(ref {collectionFieldName}, value);");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine($"    private bool _is{plural}Loaded;");
        sb.AppendLine($"    public bool Is{plural}Loaded");
        sb.AppendLine("    {");
        sb.AppendLine($"        get => _is{plural}Loaded;");
        sb.AppendLine($"        internal set => SetProperty(ref _is{plural}Loaded, value);");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine($"    internal void Unload{plural}Storage()");
        sb.AppendLine("    {");
        sb.AppendLine($"        if ({collectionFieldName} == null) return;");
        sb.AppendLine($"        {collectionFieldName} = null;");
        sb.AppendLine($"        OnPropertyChanged(nameof({plural}));");
        sb.AppendLine();
        sb.AppendLine($"        Is{plural}Loaded = false;");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        sb.AppendLine("}");

        File.WriteAllText(outputPath, sb.ToString());
        filesWritten++;
    }

    Log("");
    Log($"Batch complete: {filesWritten} file(s) written, {filesDeleted} deleted, {skippedCount} skipped by filter, {undetectedRelationships} relationship(s) could not be auto-detected.");
    FlushLog(solutionFilePath, TargetDirectory);

    Write($"Batch complete: {filesWritten} file(s) written, {filesDeleted} deleted, {skippedCount} skipped by filter, {undetectedRelationships} relationship(s) could not be auto-detected (see TODO comments).");
#>
<#+
    private string TemplateNameFallback { get { return "ModelsProject"; } }

    private string FindSolutionFile(string startDirectory) {
        var directory = new DirectoryInfo(startDirectory);
        while (directory != null) {
            var slnx = directory.GetFiles("*.slnx").FirstOrDefault();
            if (slnx != null) return slnx.FullName;
            var sln = directory.GetFiles("*.sln").FirstOrDefault();
            if (sln != null) return sln.FullName;
            directory = directory.Parent;
        }
        return string.Empty;
    }

    private string FindServiceLocator(SolutionProject project) {
        if (!Directory.Exists(project.ProjectDirectory)) return string.Empty;
        foreach (string file in Directory.GetFiles(project.ProjectDirectory, "ServiceLocator*.cs", SearchOption.AllDirectories)) {
            string folderName = Path.GetFileName(Path.GetDirectoryName(file));
            if (folderName.Equals("bin", StringComparison.OrdinalIgnoreCase) ||
                folderName.Equals("obj", StringComparison.OrdinalIgnoreCase)) continue;
            return file;
        }
        return string.Empty;
    }

    private SolutionProject FindProjectContaining(string directory) {
        string full = Path.GetFullPath(directory);
        return SolutionProjects.Values
            .Where(p => !p.IsTestProject)
            .Where(p => full.StartsWith(Path.GetFullPath(p.ProjectDirectory) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)
                     || full.Equals(Path.GetFullPath(p.ProjectDirectory), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.ProjectDirectory.Length)
            .FirstOrDefault();
    }

    private string BuildLiveFilteredCollection(string collectionsNamespace) {
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     Generated by the ModelsProject template. Do not edit — regenerated on every run.");
        sb.AppendLine("//     A live filtered projection over an ObservableCollection.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("#nullable enable");
        sb.AppendLine();
        sb.AppendLine("#pragma warning disable IDE0130 // Namespace does not match folder structure");
        sb.AppendLine();
        sb.AppendLine("using System.Collections.ObjectModel;");
        sb.AppendLine("using System.Collections.Specialized;");
        sb.AppendLine("using System.ComponentModel;");
        sb.AppendLine();
        sb.AppendLine("namespace " + collectionsNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("public sealed class LiveFilteredCollection<T> : ObservableCollection<T>, IDisposable where T : INotifyPropertyChanged {");
        sb.AppendLine();
        sb.AppendLine("    private readonly ObservableCollection<T> _source;");
        sb.AppendLine("    private readonly Func<T, bool> _filter;");
        sb.AppendLine("    private readonly HashSet<string> _watchedProperties;");
        sb.AppendLine("    private bool _disposed;");
        sb.AppendLine();
        sb.AppendLine("    public LiveFilteredCollection(ObservableCollection<T> source, Func<T, bool> filter, params string[] watchedProperties) {");
        sb.AppendLine("        _source = source;");
        sb.AppendLine("        _filter = filter;");
        sb.AppendLine("        _watchedProperties = new HashSet<string>(watchedProperties, StringComparer.Ordinal);");
        sb.AppendLine();
        sb.AppendLine("        foreach (var item in _source) {");
        sb.AppendLine("            item.PropertyChanged += OnSourceItemPropertyChanged;");
        sb.AppendLine("            if (_filter(item)) Add(item);");
        sb.AppendLine("        }");
        sb.AppendLine("        _source.CollectionChanged += OnSourceCollectionChanged;");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    private void OnSourceCollectionChanged(object sender, NotifyCollectionChangedEventArgs e) {");
        sb.AppendLine("        if (e.NewItems != null) {");
        sb.AppendLine("            foreach (T item in e.NewItems) {");
        sb.AppendLine("                item.PropertyChanged += OnSourceItemPropertyChanged;");
        sb.AppendLine("                if (_filter(item) && !Contains(item)) Add(item);");
        sb.AppendLine("            }");
        sb.AppendLine("        }");
        sb.AppendLine("        if (e.OldItems != null) {");
        sb.AppendLine("            foreach (T item in e.OldItems) {");
        sb.AppendLine("                item.PropertyChanged -= OnSourceItemPropertyChanged;");
        sb.AppendLine("                if (Contains(item)) Remove(item);");
        sb.AppendLine("            }");
        sb.AppendLine("        }");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    private void OnSourceItemPropertyChanged(object sender, PropertyChangedEventArgs e) {");
        sb.AppendLine("        if (sender is not T item) return;");
        sb.AppendLine("        if (e.PropertyName != null && !_watchedProperties.Contains(e.PropertyName)) return;");
        sb.AppendLine();
        sb.AppendLine("        bool matches = _filter(item);");
        sb.AppendLine("        bool currentlyIncluded = Contains(item);");
        sb.AppendLine("        if (matches && !currentlyIncluded) Add(item);");
        sb.AppendLine("        else if (!matches && currentlyIncluded) Remove(item);");
        sb.AppendLine("    }");
        sb.AppendLine();
        sb.AppendLine("    public void Dispose() {");
        sb.AppendLine("        if (_disposed) return;");
        sb.AppendLine("        _disposed = true;");
        sb.AppendLine();
        sb.AppendLine("        _source.CollectionChanged -= OnSourceCollectionChanged;");
        sb.AppendLine("        foreach (var item in _source) item.PropertyChanged -= OnSourceItemPropertyChanged;");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string BuildEntityInterfaces(string interfacesNamespace) {
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     Generated by the ModelsProject template. Do not edit — regenerated on every run.");
        sb.AppendLine("//     The load/save contract the generated entities resolve through.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("#nullable enable");
        sb.AppendLine();
        sb.AppendLine("#pragma warning disable IDE0130 // Namespace does not match folder structure");
        sb.AppendLine();
        sb.AppendLine("namespace " + interfacesNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("public interface IEntitySetLoader<T> {");
        sb.AppendLine("    Task<IReadOnlyList<T>> LoadAllAsync(CancellationToken ct);");
        sb.AppendLine("}");
        sb.AppendLine();
        sb.AppendLine("public interface IEntitySaver<T> {");
        sb.AppendLine("    Task SaveAsync(T entity, CancellationToken ct);");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private sealed class FileFilterRule
    {
        public string[] NamePatterns;
        public string[] ExcludeNamePatterns;
        public string[] ChangeTypes;
        public string RequiredBaseType;
        public string[] ExcludedBaseTypes;
    }

    private static readonly HashSet<string> ScalarTypes = new(StringComparer.OrdinalIgnoreCase) {
        "bool","byte","sbyte","char","decimal","double","float","int","uint","long","ulong","short","ushort",
        "string","object","void","datetime","dateonly","timeonly","timespan","guid","byte[]","var"
    };

    private static readonly HashSet<string> ReferenceScalarTypes = new(StringComparer.OrdinalIgnoreCase) {
        "string", "object", "byte[]"
    };

    private bool IsScalarType(string typeText) => ScalarTypes.Contains(typeText.TrimEnd('?'));

    private bool IsEntityLikeType(string typeText)
    {
        string bare = typeText.TrimEnd('?');
        return bare.Length > 0 && char.IsUpper(bare[0]) && !IsScalarType(bare);
    }

    private Dictionary<string, Dictionary<string, HashSet<string>>> _baseTypeIndexBySourceDirectory = new();

    private Dictionary<string, HashSet<string>> GetBaseTypeIndex(string sourceDirectory)
    {
        if (_baseTypeIndexBySourceDirectory.TryGetValue(sourceDirectory, out var cached)) return cached;

        var index = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        foreach (var filePath in Directory.GetFiles(sourceDirectory, "*.cs"))
        {
            var tree = CSharpSyntaxTree.ParseText(File.ReadAllText(filePath));
            foreach (var cls in tree.GetRoot().DescendantNodes().OfType<ClassDeclarationSyntax>())
            {
                if (cls.BaseList == null) continue;
                if (!index.TryGetValue(cls.Identifier.Text, out var baseTypes))
                    index[cls.Identifier.Text] = baseTypes = new HashSet<string>(StringComparer.Ordinal);
                foreach (var baseType in cls.BaseList.Types)
                    baseTypes.Add(baseType.Type.ToString());
            }
        }
        _baseTypeIndexBySourceDirectory[sourceDirectory] = index;
        return index;
    }

    private List<string> GetBaseTypesForFile(string sourceDirectory, string sourceFileName)
    {
        string filePath = Path.Combine(sourceDirectory, $"{sourceFileName}.cs");
        if (!File.Exists(filePath)) return new List<string>();

        var tree = CSharpSyntaxTree.ParseText(File.ReadAllText(filePath));
        var classDecl = tree.GetRoot().DescendantNodes().OfType<ClassDeclarationSyntax>().FirstOrDefault();
        if (classDecl == null) return new List<string>();

        return GetAllAncestorTypes(sourceDirectory, classDecl.Identifier.Text).ToList();
    }

    private HashSet<string> GetAllAncestorTypes(string sourceDirectory, string className, HashSet<string> visited = null)
    {
        visited ??= new HashSet<string>(StringComparer.Ordinal);
        var result = new HashSet<string>(StringComparer.Ordinal);
        if (!visited.Add(className)) return result;

        var index = GetBaseTypeIndex(sourceDirectory);
        if (!index.TryGetValue(className, out var directBaseTypes)) return result;

        foreach (var baseType in directBaseTypes)
        {
            result.Add(baseType);
            string baseTypeNameOnly = baseType.Split('<')[0].Trim();
            foreach (var ancestor in GetAllAncestorTypes(sourceDirectory, baseTypeNameOnly, visited))
                result.Add(ancestor);
        }
        return result;
    }

    private Dictionary<string, List<(string Name, string Type)>> _propertyCache = new();

    private List<(string Name, string Type)> GetPropertiesForType(string sourceDirectory, string typeName)
    {
        string key = sourceDirectory + "|" + typeName;
        if (_propertyCache.TryGetValue(key, out var cached)) return cached;

        var result = new List<(string, string)>();
        string path = Path.Combine(sourceDirectory, $"{typeName}.cs");
        if (File.Exists(path))
        {
            var tree = CSharpSyntaxTree.ParseText(File.ReadAllText(path));
            var cls = tree.GetRoot().DescendantNodes().OfType<ClassDeclarationSyntax>().FirstOrDefault(c => c.Identifier.Text == typeName);
            if (cls != null)
            {
                foreach (var p in cls.DescendantNodes().OfType<PropertyDeclarationSyntax>())
                    result.Add((p.Identifier.Text, p.Type.ToString().Trim()));
            }
        }
        _propertyCache[key] = result;
        return result;
    }

    private (string ChildFk, string ParentKey)? DetectForeignKeyPair(string sourceDirectory, string parentType, string childType)
    {
        var childProps = GetPropertiesForType(sourceDirectory, childType);
        string navPropName = childProps.FirstOrDefault(p => p.Type.TrimEnd('?') == parentType).Name;
        if (navPropName == null) return null;

        string childFk = null;
        string candidate = navPropName.EndsWith("Navigation") ? navPropName.Substring(0, navPropName.Length - "Navigation".Length) : navPropName;
        if (childProps.Any(p => p.Name == candidate && !IsEntityLikeType(p.Type))) childFk = candidate;
        if (childFk == null)
        {
            string candidate2 = parentType + "Id";
            if (childProps.Any(p => p.Name == candidate2)) childFk = candidate2;
        }
        if (childFk == null) return null;

        var parentProps = GetPropertiesForType(sourceDirectory, parentType);
        var matchedParentProp = parentProps.FirstOrDefault(p => p.Name.Equals(childFk, StringComparison.OrdinalIgnoreCase));
        string parentKey = matchedParentProp.Name != null ? matchedParentProp.Name
                          : parentProps.Any(p => p.Name == "Id") ? "Id"
                          : null;
        if (parentKey == null) return null;

        return (childFk, parentKey);
    }

    private bool NameMatches(string fileName, string[] patterns)
    {
        if (patterns == null || patterns.Length == 0) return true;
        return patterns.Any(p => Regex.IsMatch(fileName, "^" + Regex.Escape(p).Replace("\\*", ".*").Replace("\\?", ".") + "$", RegexOptions.IgnoreCase));
    }

    private bool RuleMatches(FileFilterRule rule, string fileName, string changeType, Func<List<string>> getBaseTypes)
    {
        if (!NameMatches(fileName, rule.NamePatterns)) return false;
        if (rule.ExcludeNamePatterns != null && NameMatches(fileName, rule.ExcludeNamePatterns)) return false;
        if (rule.ChangeTypes != null && rule.ChangeTypes.Length > 0 && !rule.ChangeTypes.Contains(changeType, StringComparer.OrdinalIgnoreCase)) return false;
        if (rule.RequiredBaseType != null || rule.ExcludedBaseTypes != null)
        {
            var baseTypes = getBaseTypes();
            if (rule.RequiredBaseType != null && !baseTypes.Contains(rule.RequiredBaseType)) return false;
            if (rule.ExcludedBaseTypes != null && rule.ExcludedBaseTypes.Any(baseTypes.Contains)) return false;
        }
        return true;
    }

    private bool ShouldProcess(FileFilterRule[] rules, string fileName, string changeType, Func<List<string>> getBaseTypes)
        => rules.Any(r => RuleMatches(r, fileName, changeType, getBaseTypes));

    private string GetProjectRootNamespace(string targetDirectory)
    {
        var dir = new DirectoryInfo(targetDirectory);
        string csprojPath = null;
        while (dir != null)
        {
            var found = dir.GetFiles("*.csproj").FirstOrDefault();
            if (found != null) { csprojPath = found.FullName; break; }
            dir = dir.Parent;
        }
        if (csprojPath == null) return "GeneratedModels";

        var csprojXml = XDocument.Load(csprojPath);
        string rootNamespace = csprojXml.Descendants("RootNamespace").FirstOrDefault()?.Value;
        if (string.IsNullOrWhiteSpace(rootNamespace)) rootNamespace = Path.GetFileNameWithoutExtension(csprojPath);
        return rootNamespace;
    }

    private string ComputeNamespace(string targetDirectory)
    {
        var dir = new DirectoryInfo(targetDirectory);
        string csprojPath = null, projectDir = null;
        while (dir != null)
        {
            var found = dir.GetFiles("*.csproj").FirstOrDefault();
            if (found != null) { csprojPath = found.FullName; projectDir = dir.FullName; break; }
            dir = dir.Parent;
        }
        if (csprojPath == null) return "GeneratedModels";

        string rootNamespace = GetProjectRootNamespace(targetDirectory);

        string relative = GetRelativePathManual(projectDir, targetDirectory);
        if (string.IsNullOrEmpty(relative) || relative == ".") return rootNamespace;

        var segments = relative.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).ToList();
        string leafFolderName = segments.Count > 0 ? segments[segments.Count - 1] : null;

        bool isConventionalGeneratedFolder = leafFolderName != null &&
            (leafFolderName.Equals("AutoGenerated", StringComparison.OrdinalIgnoreCase) ||
             leafFolderName.Equals("Generated", StringComparison.OrdinalIgnoreCase));

        string rootNamespaceLastSegment = rootNamespace.Split('.').LastOrDefault();
        bool duplicatesRootTail = leafFolderName != null && rootNamespaceLastSegment != null &&
            leafFolderName.Equals(rootNamespaceLastSegment, StringComparison.OrdinalIgnoreCase);

        if (isConventionalGeneratedFolder || duplicatesRootTail) segments.RemoveAt(segments.Count - 1);
        if (segments.Count == 0) return rootNamespace;

        var sanitized = segments
            .Select(s => Regex.Replace(s, @"[^A-Za-z0-9_]", "_"))
            .Select(s => char.IsDigit(s[0]) ? "_" + s : s);
        return rootNamespace + "." + string.Join(".", sanitized);
    }

    private string GetRelativePathManual(string basePath, string targetPath)
    {
        if (!basePath.EndsWith(Path.DirectorySeparatorChar.ToString())) basePath += Path.DirectorySeparatorChar;
        var baseUri = new Uri(basePath);
        var targetUriPath = targetPath.EndsWith(Path.DirectorySeparatorChar.ToString()) ? targetPath : targetPath + Path.DirectorySeparatorChar;
        var targetUri = new Uri(targetUriPath);
        if (baseUri.Scheme != targetUri.Scheme) return targetPath;
        var relativeUri = baseUri.MakeRelativeUri(targetUri);
        string relativePath = Uri.UnescapeDataString(relativeUri.ToString());
        relativePath = relativePath.Replace('/', Path.DirectorySeparatorChar);
        return relativePath.TrimEnd(Path.DirectorySeparatorChar);
    }

    private string Pluralize(string word)
    {
        if (string.IsNullOrEmpty(word)) return word ?? string.Empty;
        if (word.EndsWith("y") && word.Length > 1 && !"aeiouAEIOU".Contains(word[word.Length - 2]))
            return word.Substring(0, word.Length - 1) + "ies";
        if (word.EndsWith("s") || word.EndsWith("x") || word.EndsWith("z") || word.EndsWith("ch") || word.EndsWith("sh"))
            return word + "es";
        return word + "s";
    }
#>