<#+
    // Minimal component under test. Its only job is to prove that a relative include
    // resolves correctly when compiled by Mono.TextTemplating (Coder.App's engine),
    // rather than by Visual Studio's own T4 host, which may resolve paths differently.
    private string ProbeGreeting(string solutionFilePath) {
        return $"Include resolved successfully. Solution: {Path.GetFileName(solutionFilePath)}";
    }

    private string ProbeIdentity() {
        return "IncludeProbe.ttinclude (from BasicTemplates/Shared/)";
    }
#>