<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Memory" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ parameter name="MetadataFilePath" type="System.String" #>
<#@ parameter name="TargetDirectory" type="System.String" #>
<#
    // ============================================================
    // FILE FILTERS — the only thing you should need to edit to
    // change what this template acts on. Rules are OR'd together;
    // within one rule, every set criterion must match (AND).
    // ============================================================
    var Filters = new[] {
        new FileFilterRule {
            NamePatterns = new[] { "*.cs" },
            ExcludeNamePatterns = new[] { "*DbContext.cs", "*.Designer.cs" }
        }
    };

    // 1. VALIDATE & READ INPUT
    if (string.IsNullOrWhiteSpace(MetadataFilePath) || !File.Exists(MetadataFilePath)) 
    {
        Write("Error: MetadataFilePath is missing or invalid.");
        return string.Empty;
    }

    if (string.IsNullOrWhiteSpace(TargetDirectory))
    {
        Write("Error: TargetDirectory was not provided.");
        return string.Empty;
    }

    string metadataJson = File.ReadAllText(MetadataFilePath);
    using var document = JsonDocument.Parse(metadataJson);
    var root = document.RootElement;
    string templatePath = Host.TemplateFile;
    string namespaceName = ComputeNamespace(TargetDirectory);

    if (!root.TryGetProperty("Files", out var filesElement))
    {
        Write("Error: metadata does not contain a Files array.");
        return string.Empty;
    }

    int generatedCount = 0;
    int deletedCount = 0;
    int skippedCount = 0;

    // 2. LOOP OVER EVERY CHANGED FILE IN THE BATCH — all within this single process invocation
    foreach (var fileEntry in filesElement.EnumerateArray())
    {
        string sourceFileName = fileEntry.GetProperty("SourceFileName").GetString();
        string changeType = fileEntry.GetProperty("ChangeType").GetString();

        // 2a. FILTER GATE — skip anything that doesn't match, before any file I/O.
        if (!ShouldProcess(Filters, $"{sourceFileName}.cs", changeType, () => new List<string>()))
        {
            skippedCount++;
            continue;
        }

        string outputFilePath = Path.Combine(TargetDirectory, $"{sourceFileName}ViewModel.cs");

        // 2b. HANDLE FILE DELETIONS
        if (changeType == "Deleted")
        {
            if (File.Exists(outputFilePath))
            {
                File.Delete(outputFilePath);
                deletedCount++;
            }
            continue;
        }

        // 2c. HANDLE RENAMES: remove the stale generated file for the OLD source name
        // before generating the new one below. Falls through intentionally.
        if (changeType == "Renamed")
        {
            string oldSourceFileName = fileEntry.TryGetProperty("OldSourceFileName", out var oldNameElement)
                ? oldNameElement.GetString()
                : null;

            if (!string.IsNullOrWhiteSpace(oldSourceFileName) && oldSourceFileName != sourceFileName)
            {
                string oldOutputFilePath = Path.Combine(TargetDirectory, $"{oldSourceFileName}ViewModel.cs");

                if (File.Exists(oldOutputFilePath))
                {
                    File.Delete(oldOutputFilePath);
                }
            }
        }

        // 3. GENERATE THE C# CONTENT for this file
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     This code was generated by a tool.");
        sb.AppendLine($"//     Template: {templatePath}");
        sb.AppendLine($"//     Source Input: {sourceFileName}.cs");
        sb.AppendLine("//");
        sb.AppendLine("//     Changes to this file may cause incorrect behavior and will be lost if");
        sb.AppendLine("//     the code is regenerated. If you need to extend this behavior, please ");
        sb.AppendLine("//     implement a partial class in a separate physical file.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("using System;");
        sb.AppendLine("using System.ComponentModel;");
        sb.AppendLine();
        sb.AppendLine($"namespace {namespaceName}");
        sb.AppendLine("{");

        if (fileEntry.TryGetProperty("Classes", out var classesElement))
        {
            foreach (var cls in classesElement.EnumerateArray())
            {
                string className = cls.GetProperty("ClassName").GetString();

                sb.AppendLine($"    public partial class {className}ViewModel : INotifyPropertyChanged");
                sb.AppendLine("    {");
                sb.AppendLine("        public event PropertyChangedEventHandler PropertyChanged;");
                sb.AppendLine();

                if (cls.TryGetProperty("Properties", out var propertiesElement))
                {
                    foreach (var prop in propertiesElement.EnumerateArray())
                    {
                        string propName = prop.GetProperty("Name").GetString();
                        string propType = prop.GetProperty("Type").GetString();

                        string fieldName = "_" + char.ToLower(propName[0]) + propName.Substring(1);

                        sb.AppendLine($"        private {propType} {fieldName};");
                        sb.AppendLine($"        public {propType} {propName}");
                        sb.AppendLine("        {");
                        sb.AppendLine($"            get => {fieldName};");
                        sb.AppendLine($"            set");
                        sb.AppendLine("            {");
                        sb.AppendLine($"                if ({fieldName} != value)");
                        sb.AppendLine("                {");
                        sb.AppendLine($"                    {fieldName} = value;");
                        sb.AppendLine($"                    PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof({propName})));");
                        sb.AppendLine("                }");
                        sb.AppendLine("            }");
                        sb.AppendLine("        }");
                        sb.AppendLine();
                    }
                }
                sb.AppendLine("    }");
            }
        }

        sb.AppendLine("}");

        // 4. WRITE FILE TO TARGET DIRECTORY
        File.WriteAllText(outputFilePath, sb.ToString());
        generatedCount++;
    }

    // 5. MANIFEST LOGGING: one summary line for the whole batch instead of per-file
    Write($"Batch complete: {generatedCount} file(s) generated, {deletedCount} file(s) deleted, {skippedCount} file(s) skipped by filter.");
#>
<#+
    private sealed class FileFilterRule
    {
        public string[] NamePatterns;          // wildcard, OR'd — null/empty = match any name
        public string[] ExcludeNamePatterns;   // wildcard, OR'd — any match rejects, overrides NamePatterns
        public string[] ChangeTypes;           // OR'd — null/empty = match any ChangeType
        public string RequiredBaseType;        // class must derive from this — null = skip check
        public string[] ExcludedBaseTypes;     // class must NOT derive from any of these — null = skip check
    }

    private bool NameMatches(string fileName, string[] patterns)
    {
        if (patterns == null || patterns.Length == 0) return true;
        return patterns.Any(p => Regex.IsMatch(fileName, "^" + Regex.Escape(p).Replace("\\*", ".*").Replace("\\?", ".") + "$", RegexOptions.IgnoreCase));
    }

    private bool RuleMatches(FileFilterRule rule, string fileName, string changeType, Func<List<string>> getBaseTypes)
    {
        if (!NameMatches(fileName, rule.NamePatterns)) return false;
        if (rule.ExcludeNamePatterns != null && NameMatches(fileName, rule.ExcludeNamePatterns)) return false;
        if (rule.ChangeTypes != null && rule.ChangeTypes.Length > 0 && !rule.ChangeTypes.Contains(changeType, StringComparer.OrdinalIgnoreCase)) return false;

        if (rule.RequiredBaseType != null || rule.ExcludedBaseTypes != null)
        {
            var baseTypes = getBaseTypes();
            if (rule.RequiredBaseType != null && !baseTypes.Contains(rule.RequiredBaseType)) return false;
            if (rule.ExcludedBaseTypes != null && rule.ExcludedBaseTypes.Any(baseTypes.Contains)) return false;
        }
        return true;
    }

    private bool ShouldProcess(FileFilterRule[] rules, string fileName, string changeType, Func<List<string>> getBaseTypes)
        => rules.Any(r => RuleMatches(r, fileName, changeType, getBaseTypes));

    private string ComputeNamespace(string targetDirectory)
    {
        var dir = new DirectoryInfo(targetDirectory);
        string csprojPath = null, projectDir = null;
        while (dir != null)
        {
            var found = dir.GetFiles("*.csproj").FirstOrDefault();
            if (found != null) { csprojPath = found.FullName; projectDir = dir.FullName; break; }
            dir = dir.Parent;
        }
        if (csprojPath == null) return "GeneratedModels";

        string rootNamespace = null;
        var csprojXml = XDocument.Load(csprojPath);
        rootNamespace = csprojXml.Descendants("RootNamespace").FirstOrDefault()?.Value;
        if (string.IsNullOrWhiteSpace(rootNamespace)) rootNamespace = Path.GetFileNameWithoutExtension(csprojPath);

        string relative = GetRelativePathManual(projectDir, targetDirectory);
        if (string.IsNullOrEmpty(relative) || relative == ".") return rootNamespace;

        var segments = relative.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            .Select(s => Regex.Replace(s, @"[^A-Za-z0-9_]", "_"))
            .Select(s => char.IsDigit(s[0]) ? "_" + s : s);
        return rootNamespace + "." + string.Join(".", segments);
    }

    private string GetRelativePathManual(string basePath, string targetPath)
    {
        if (!basePath.EndsWith(Path.DirectorySeparatorChar.ToString())) basePath += Path.DirectorySeparatorChar;
        var baseUri = new Uri(basePath);
        var targetUriPath = targetPath.EndsWith(Path.DirectorySeparatorChar.ToString()) ? targetPath : targetPath + Path.DirectorySeparatorChar;
        var targetUri = new Uri(targetUriPath);
        if (baseUri.Scheme != targetUri.Scheme) return targetPath;
        var relativeUri = baseUri.MakeRelativeUri(targetUri);
        string relativePath = Uri.UnescapeDataString(relativeUri.ToString());
        relativePath = relativePath.Replace('/', Path.DirectorySeparatorChar);
        return relativePath.TrimEnd(Path.DirectorySeparatorChar);
    }
#>