<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ parameter name="MetadataFilePath" type="System.String" #>
<#@ parameter name="TargetDirectory" type="System.String" #>
<#
    // 1. VALIDATE & READ INPUT
    if (string.IsNullOrWhiteSpace(MetadataFilePath) || !File.Exists(MetadataFilePath)) 
    {
        Write("Error: MetadataFilePath is missing or invalid.");
        return string.Empty;
    }

    if (string.IsNullOrWhiteSpace(TargetDirectory))
    {
        Write("Error: TargetDirectory was not provided.");
        return string.Empty;
    }

    string metadataJson = File.ReadAllText(MetadataFilePath);
    using var document = JsonDocument.Parse(metadataJson);
    var root = document.RootElement;
    string templatePath = Host.TemplateFile;

    if (!root.TryGetProperty("Files", out var filesElement))
    {
        Write("Error: metadata does not contain a Files array.");
        return string.Empty;
    }

    int generatedCount = 0;
    int deletedCount = 0;

    // 2. LOOP OVER EVERY CHANGED FILE IN THE BATCH — all within this single process invocation
    foreach (var fileEntry in filesElement.EnumerateArray())
    {
        string sourceFileName = fileEntry.GetProperty("SourceFileName").GetString();
        string changeType = fileEntry.GetProperty("ChangeType").GetString();
        string outputFilePath = Path.Combine(TargetDirectory, $"{sourceFileName}ViewModel.cs");

        // 2a. HANDLE FILE DELETIONS
        if (changeType == "Deleted")
        {
            if (File.Exists(outputFilePath))
            {
                File.Delete(outputFilePath);
                deletedCount++;
            }
            continue;
        }

        // 2b. HANDLE RENAMES: remove the stale generated file for the OLD source name
        // before generating the new one below. Falls through intentionally.
        if (changeType == "Renamed")
        {
            string oldSourceFileName = fileEntry.TryGetProperty("OldSourceFileName", out var oldNameElement)
                ? oldNameElement.GetString()
                : null;

            if (!string.IsNullOrWhiteSpace(oldSourceFileName) && oldSourceFileName != sourceFileName)
            {
                string oldOutputFilePath = Path.Combine(TargetDirectory, $"{oldSourceFileName}ViewModel.cs");

                if (File.Exists(oldOutputFilePath))
                {
                    File.Delete(oldOutputFilePath);
                }
            }
        }

        // 3. GENERATE THE C# CONTENT for this file
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     This code was generated by a tool.");
        sb.AppendLine($"//     Template: {templatePath}");
        sb.AppendLine($"//     Source Input: {sourceFileName}.cs");
        sb.AppendLine("//");
        sb.AppendLine("//     Changes to this file may cause incorrect behavior and will be lost if");
        sb.AppendLine("//     the code is regenerated. If you need to extend this behavior, please ");
        sb.AppendLine("//     implement a partial class in a separate physical file.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("using System;");
        sb.AppendLine("using System.ComponentModel;");
        sb.AppendLine();
        sb.AppendLine("namespace AutoGenerated.ViewModels");
        sb.AppendLine("{");

        if (fileEntry.TryGetProperty("Classes", out var classesElement))
        {
            foreach (var cls in classesElement.EnumerateArray())
            {
                string className = cls.GetProperty("ClassName").GetString();

                sb.AppendLine($"    public partial class {className}ViewModel : INotifyPropertyChanged");
                sb.AppendLine("    {");
                sb.AppendLine("        public event PropertyChangedEventHandler PropertyChanged;");
                sb.AppendLine();

                if (cls.TryGetProperty("Properties", out var propertiesElement))
                {
                    foreach (var prop in propertiesElement.EnumerateArray())
                    {
                        string propName = prop.GetProperty("Name").GetString();
                        string propType = prop.GetProperty("Type").GetString();

                        string fieldName = "_" + char.ToLower(propName[0]) + propName.Substring(1);

                        sb.AppendLine($"        private {propType} {fieldName};");
                        sb.AppendLine($"        public {propType} {propName}");
                        sb.AppendLine("        {");
                        sb.AppendLine($"            get => {fieldName};");
                        sb.AppendLine($"            set");
                        sb.AppendLine("            {");
                        sb.AppendLine($"                if ({fieldName} != value)");
                        sb.AppendLine("                {");
                        sb.AppendLine($"                    {fieldName} = value;");
                        sb.AppendLine($"                    PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof({propName})));");
                        sb.AppendLine("                }");
                        sb.AppendLine("            }");
                        sb.AppendLine("        }");
                        sb.AppendLine();
                    }
                }
                sb.AppendLine("    }");
            }
        }

        sb.AppendLine("}");

        // 4. WRITE FILE TO TARGET DIRECTORY
        File.WriteAllText(outputFilePath, sb.ToString());
        generatedCount++;
    }

    // 5. MANIFEST LOGGING: one summary line for the whole batch instead of per-file
    Write($"Batch complete: {generatedCount} file(s) generated, {deletedCount} file(s) deleted.");
#>
