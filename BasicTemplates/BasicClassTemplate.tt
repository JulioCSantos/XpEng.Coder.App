<#@ template language="C#" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Memory" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ parameter name="MetadataFilePath" type="System.String" #>
<#@ parameter name="TargetDirectory" type="System.String" #>
<#
    // ============================================================
    // FILE FILTERS — the only thing you should need to edit to
    // change what this template acts on. Rules are OR'd together;
    // within one rule, every set criterion must match (AND).
    // ============================================================
    var Filters = new[] {
        new FileFilterRule {
            NamePatterns = new[] { "*.cs" },
            ExcludeNamePatterns = new[] { "*DbContext.cs", "*.Designer.cs", "*.g.cs" }
        }
    };

    // 1. VALIDATE & READ INPUT
    if (string.IsNullOrWhiteSpace(MetadataFilePath) || !File.Exists(MetadataFilePath)) 
    {
        Write("Error: MetadataFilePath is missing or invalid.");
        return string.Empty;
    }

    if (string.IsNullOrWhiteSpace(TargetDirectory))
    {
        Write("Error: TargetDirectory was not provided.");
        return string.Empty;
    }

    string metadataJson = File.ReadAllText(MetadataFilePath);
    using var document = JsonDocument.Parse(metadataJson);
    var root = document.RootElement;
    string templatePath = Host.TemplateFile;
    string namespaceName = ComputeNamespace(TargetDirectory);

    if (!root.TryGetProperty("Files", out var filesElement))
    {
        Write("Error: metadata does not contain a Files array.");
        return string.Empty;
    }

    int generatedCount = 0;
    int deletedCount = 0;
    int skippedCount = 0;

    // 2. LOOP OVER EVERY CHANGED FILE IN THE BATCH — all within this single process invocation
    foreach (var fileEntry in filesElement.EnumerateArray())
    {
        string sourceFileName = fileEntry.GetProperty("SourceFileName").GetString();
        string changeType = fileEntry.GetProperty("ChangeType").GetString();

        // 2a. FILTER GATE — skip anything that doesn't match, before any file I/O.
        if (!ShouldProcess(Filters,